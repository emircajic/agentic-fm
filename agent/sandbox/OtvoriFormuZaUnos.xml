<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="False" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["Pozvana skripta"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA[Get(ScriptName) & ¶ & Get(ScriptParameter)]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="True">
        <Calculation><![CDATA["OK"]]></Calculation>
      </Button>
      <Button CommitState="False">
        <Calculation><![CDATA["Cancel"]]></Calculation>
      </Button>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="False" id="122" name="New Window"/>
  <Step enable="True" id="6" name="Go to Layout">
    <LayoutDestination value="SelectedLayout"/>
    <Layout id="186" name="ServiceOrderDetails"/>
    <Animation value="SlideinfromLeft"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get(ScriptParameter)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$prefill</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $prefill; "date" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$datum</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $prefill; "timeStart" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$timeStart</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $prefill; "timeEnd" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$timeEnd</Name>
  </Step>
  <Step enable="True" id="7" name="New Record/Request"/>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Get(CurrentDate)]]></Calculation>
    <Field table="ServiceOrders" id="29" name="Date"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>JobDate/JobTime default to now when the caller omits them (e.g. the kanban toolbar "+", which passes an empty payload — it can never bake Get(CurrentTime) into the toolbar URL calc without forcing constant WV reloads).</Text>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[If ( not IsEmpty ( $datum ) ; JSDateToFMDate ( $datum ) ; Get ( CurrentDate ) )]]></Calculation>
    <Field table="ServiceOrders" id="41" name="JobDate"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[If ( not IsEmpty ( $timeStart ) ; $timeStart ; Get ( CurrentTime ) )]]></Calculation>
    <Field table="ServiceOrders" id="35" name="JobTime"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $timeEnd )]]></Calculation>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$timeEnd]]></Calculation>
    <Field table="ServiceOrders" id="53" name="JobTimeEnd"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["Zakazan"]]></Calculation>
    <Field table="ServiceOrders" id="11" name="Status"/>
  </Step>
</fmxmlsnippet>
