<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">

  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Restore state for the current layout, dispatching to "Restore_&lt;BaseLayoutName&gt;".</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>PARAM:   JSON state object (typically from $$LAYOUT.STATE[layoutID]). See state contract in Capture Layout State.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>DISPATCH: error 104 (missing per-layout restore) is silently ignored -- means the layout has no state to restore.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>

  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
    <Name>$state</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[IsEmpty ( $state ) or $state = "{}" or $state = "null"]]></Calculation>
  </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[""]]></Calculation>
    </Step>
  <Step enable="True" id="70" name="End If"/>

  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[_GetBaseLayoutName ( Get ( LayoutName ) )]]></Calculation></Value>
    <Name>$baseLayout</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["Restore_" & $baseLayout]]></Calculation></Value>
    <Name>$restoreScriptName</Name>
  </Step>

  <Step enable="True" id="1" name="Perform Script">
    <Calculated><Calculation><![CDATA[$restoreScriptName]]></Calculation></Calculated>
    <Calculation><![CDATA[$state]]></Calculation>
  </Step>

  <Step enable="True" id="89" name="# (comment)">
    <Text>Error 104 (script missing) is expected for layouts without a Restore_ partner -- ignore.</Text>
  </Step>

</fmxmlsnippet>
