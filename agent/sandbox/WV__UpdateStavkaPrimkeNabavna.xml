<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">

  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Update StavkePrimke.NabavnaCijenaStavke for one row, then refresh the missingCost modal.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Param: JSON {id, value, scope}.  id = StavkePrimke.PrimaryKey, value = nabavna cijena (number).</Text>
  </Step>

  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>

  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
    <Name>$param</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $param ; "id" )]]></Calculation></Value>
    <Name>$id</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[GetAsNumber ( JSONGetElement ( $param ; "value" ) )]]></Calculation></Value>
    <Name>$value</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[If ( IsEmpty ( JSONGetElement ( $param ; "scope" ) ) ; "day" ; JSONGetElement ( $param ; "scope" ) )]]></Calculation></Value>
    <Name>$scope</Name>
  </Step>

  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $id ) or $value <= 0]]></Calculation>
  </Step>
    <Step enable="True" id="89" name="# (comment)">
      <Text>Invalid input — bail silently. The WV ignores stale rows.</Text>
    </Step>
    <Step enable="True" id="103" name="Exit Script"/>
  <Step enable="True" id="70" name="End If"/>

  <Step enable="True" id="89" name="# (comment)">
    <Text>MARK: UPDATE</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["UPDATE StavkePrimke SET NabavnaCijenaStavke = " & $value & " WHERE PrimaryKey = " & epSQLQuote ( $id )]]></Calculation></Value>
    <Name>$sql</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[epSQLExecute ( $sql ; "" ; "" )]]></Calculation></Value>
    <Name>$err</Name>
  </Step>

  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
  </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	["modal" ; "missingCost" ; JSONString] ;
	["error" ; $err          ; JSONString]
)]]></Calculation></Value>
      <Name>$payload</Name>
    </Step>
    <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
      <ObjectName><Calculation><![CDATA["wv_salesDashboard"]]></Calculation></ObjectName>
      <FunctionName><Calculation><![CDATA["receiveModalData"]]></Calculation></FunctionName>
      <Parameters Count="1">
        <P><Calculation><![CDATA[$payload]]></Calculation></P>
      </Parameters>
    </Step>
    <Step enable="True" id="103" name="Exit Script"/>
  <Step enable="True" id="70" name="End If"/>

  <Step enable="True" id="89" name="# (comment)">
    <Text>MARK: Re-push the missingCost list — the fixed row will naturally drop out.</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	["modal" ; "missingCost" ; JSONString] ;
	["scope" ; $scope        ; JSONString]
)]]></Calculation></Value>
    <Name>$refreshParam</Name>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[$refreshParam]]></Calculation>
    <Script id="0" name="WV__SalesDashboardModal"/>
  </Step>
  <Step enable="True" id="103" name="Exit Script"/>

</fmxmlsnippet>
