<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Pull StavkePrimke + Primke + Artikli with three flat epSQL queries, merge aggregates in FM via JSON dicts, group by Primka, return JSON payload for the picker.</Text>
  </Step>
  <Step enable="False" id="61" name="Insert Text">
    <SelectAll state="False"/>
    <Text>PARAMS: serviceOrderID (text, required) | callbackScript (text, required) | callbackContext (object, optional)&#xD;RETURNS: data.groupCount (number) | data.stavkeCount (number) | data.scriptPayload (object)</Text>
    <Field>$README</Field>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "serviceOrderID|callbackScript|callbackContext" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Log.add ( "info" ; "SO_PRIMKA_PICKER_START" ; "Building picker for serviceOrderID " & $serviceOrderID ; $params )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text># MARK: Validate</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $serviceOrderID )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "serviceOrderID is required" ; "serviceOrderID" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $callbackScript )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "callbackScript is required" ; "callbackScript" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Response_HasErrors ( $response )]]></Calculation>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text># MARK: Query A — SP + Primke + Artikli, no aggregates, ordered for display</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLExecute (
	"SELECT" &
	"  Primke.PrimaryKey," &
	"  Primke.BrojFaktureDobavljaca," &
	"  Primke.DatumPrimitka," &
	"  StavkePrimke.PrimaryKey," &
	"  StavkePrimke.ForeignKeyArtikalID," &
	"  Artikli.SifraArtikla," &
	"  Artikli.NazivArtikla," &
	"  StavkePrimke.Kolicina," &
	"  StavkePrimke.NabavnaCijenaStavke," &
	"  StavkePrimke.ProdajnaCijena," &
	"  StavkePrimke.JM" &
	" FROM StavkePrimke" &
	" JOIN Primke  ON Primke.PrimaryKey  = StavkePrimke.ForeignKeyPrimkaID" &
	" JOIN Artikli ON Artikli.PrimaryKey = StavkePrimke.ForeignKeyArtikalID" &
	" ORDER BY Primke.DatumPrimitka DESC, Primke.BrojFaktureDobavljaca, Artikli.NazivArtikla" ;
	"useSQLResult=rs_sp"
)]]></Calculation>
    </Value>
    <Name>$sqlErr</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $sqlErr )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "SQL_ERROR" ; "epSQL Query A failed: " & $sqlErr ; "" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text># MARK: Query B — transferred sums by SP (one GROUP BY scan)</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLExecute (
	"SELECT ForeignKeyStavkaPrimkeID, SUM ( Qty )" &
	" FROM ServiceOrderLines" &
	" GROUP BY ForeignKeyStavkaPrimkeID" ;
	"useSQLResult=rs_tr"
)]]></Calculation>
    </Value>
    <Name>$sqlErr</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $sqlErr )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResultDelete ( "rs_sp" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "SQL_ERROR" ; "epSQL Query B failed: " & $sqlErr ; "" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text># MARK: Query C — returned sums by SP (one GROUP BY scan)</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLExecute (
	"SELECT ForeignKeyStavkaPrimkeID, SUM ( Kolicina )" &
	" FROM StavkePovrata" &
	" GROUP BY ForeignKeyStavkaPrimkeID" ;
	"useSQLResult=rs_ret"
)]]></Calculation>
    </Value>
    <Name>$sqlErr</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $sqlErr )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResultDelete ( "rs_sp" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResultDelete ( "rs_tr" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "SQL_ERROR" ; "epSQL Query C failed: " & $sqlErr ; "" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text># MARK: Build aggregate dicts — JSON objects keyed by stavkaPK</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["{}"]]></Calculation>
    </Value>
    <Name>$dictT</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResultRowCount ( "rs_tr" )]]></Calculation>
    </Value>
    <Name>$rowsT</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Name>$j</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Defer"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$j ≥ $rowsT]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $dictT ; "k" & epSQLResult ( $j ; 0 ; "rs_tr" ) ; GetAsNumber ( epSQLResult ( $j ; 1 ; "rs_tr" ) ) ; JSONNumber )]]></Calculation>
    </Value>
    <Name>$dictT</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$j + 1]]></Calculation>
    </Value>
    <Name>$j</Name>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResultDelete ( "rs_tr" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["{}"]]></Calculation>
    </Value>
    <Name>$dictR</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResultRowCount ( "rs_ret" )]]></Calculation>
    </Value>
    <Name>$rowsR</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Name>$j</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Defer"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$j ≥ $rowsR]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $dictR ; "k" & epSQLResult ( $j ; 0 ; "rs_ret" ) ; GetAsNumber ( epSQLResult ( $j ; 1 ; "rs_ret" ) ) ; JSONNumber )]]></Calculation>
    </Value>
    <Name>$dictR</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$j + 1]]></Calculation>
    </Value>
    <Name>$j</Name>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResultDelete ( "rs_ret" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text># MARK: Walk Query A — lookup aggregates from dicts, filter qtyAvailable &gt; 0, group by Primka</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResultRowCount ( "rs_sp" )]]></Calculation>
    </Value>
    <Name>$rowCount</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["[]"]]></Calculation>
    </Value>
    <Name>$groups</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["[]"]]></Calculation>
    </Value>
    <Name>$currentStavke</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["{}"]]></Calculation>
    </Value>
    <Name>$currentGroup</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[""]]></Calculation>
    </Value>
    <Name>$lastPrimkaPK</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Name>$groupCount</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Name>$totalStavke</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Defer"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$i ≥ $rowCount]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResult ( $i ; 3 ; "rs_sp" )]]></Calculation>
    </Value>
    <Name>$stavkaPK</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsNumber ( epSQLResult ( $i ; 7 ; "rs_sp" ) )]]></Calculation>
    </Value>
    <Name>$kolicina</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
	~raw = JSONGetElement ( $dictT ; "k" & $stavkaPK )
] ; Case (
	Left ( ~raw ; 1 ) = "?" ; 0 ;
	IsEmpty ( ~raw )        ; 0 ;
	GetAsNumber ( ~raw )
) )]]></Calculation>
    </Value>
    <Name>$qtyTransferred</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
	~raw = JSONGetElement ( $dictR ; "k" & $stavkaPK )
] ; Case (
	Left ( ~raw ; 1 ) = "?" ; 0 ;
	IsEmpty ( ~raw )        ; 0 ;
	GetAsNumber ( ~raw )
) )]]></Calculation>
    </Value>
    <Name>$qtyReturned</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Max ( 0 ; $kolicina - $qtyTransferred - $qtyReturned )]]></Calculation>
    </Value>
    <Name>$qtyAvailable</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$qtyAvailable > 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResult ( $i ; 0 ; "rs_sp" )]]></Calculation>
    </Value>
    <Name>$primkaPK</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$primkaPK ≠ $lastPrimkaPK]]></Calculation>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $lastPrimkaPK )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $currentGroup ; "stavke" ; $currentStavke ; JSONArray )]]></Calculation>
    </Value>
    <Name>$currentGroup</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $groups ; "[+]" ; $currentGroup ; JSONObject )]]></Calculation>
    </Value>
    <Name>$groups</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$groupCount + 1]]></Calculation>
    </Value>
    <Name>$groupCount</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "primkaPK"    ; $primkaPK                                                       ; JSONString ] ;
	[ "brojFakture" ; epSQLResult ( $i ; 1 ; "rs_sp" )                                ; JSONString ] ;
	[ "datum"       ; GetAsText ( GetAsDate ( epSQLResult ( $i ; 2 ; "rs_sp" ) ) )    ; JSONString ]
)]]></Calculation>
    </Value>
    <Name>$currentGroup</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["[]"]]></Calculation>
    </Value>
    <Name>$currentStavke</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$primkaPK]]></Calculation>
    </Value>
    <Name>$lastPrimkaPK</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "stavkaPK"       ; $stavkaPK                                            ; JSONString ] ;
	[ "artikalPK"      ; epSQLResult ( $i ; 4 ; "rs_sp" )                     ; JSONString ] ;
	[ "sifra"          ; epSQLResult ( $i ; 5 ; "rs_sp" )                     ; JSONString ] ;
	[ "naziv"          ; epSQLResult ( $i ; 6 ; "rs_sp" )                     ; JSONString ] ;
	[ "kolicina"       ; $kolicina                                            ; JSONNumber ] ;
	[ "nabavna"        ; GetAsNumber ( epSQLResult ( $i ; 8 ; "rs_sp" ) )     ; JSONNumber ] ;
	[ "prodajna"       ; GetAsNumber ( epSQLResult ( $i ; 9 ; "rs_sp" ) )     ; JSONNumber ] ;
	[ "qtyAvailable"   ; $qtyAvailable                                        ; JSONNumber ] ;
	[ "jm"             ; epSQLResult ( $i ; 10 ; "rs_sp" )                    ; JSONString ] ;
	[ "transferStatus" ; If ( $qtyTransferred > 0 ; "Partially Used" ; "Available" ) ; JSONString ]
)]]></Calculation>
    </Value>
    <Name>$stavkaObj</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $currentStavke ; "[+]" ; $stavkaObj ; JSONObject )]]></Calculation>
    </Value>
    <Name>$currentStavke</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$totalStavke + 1]]></Calculation>
    </Value>
    <Name>$totalStavke</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$i + 1]]></Calculation>
    </Value>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text># Flush the last group</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $lastPrimkaPK )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $currentGroup ; "stavke" ; $currentStavke ; JSONArray )]]></Calculation>
    </Value>
    <Name>$currentGroup</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $groups ; "[+]" ; $currentGroup ; JSONObject )]]></Calculation>
    </Value>
    <Name>$groups</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$groupCount + 1]]></Calculation>
    </Value>
    <Name>$groupCount</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLResultDelete ( "rs_sp" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$totalStavke = 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "NO_AVAILABLE_STAVKE" ; "No StavkePrimke with available quantity found" ; "" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text># MARK: Build payload</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "serviceOrderID"  ; $serviceOrderID  ; JSONString ] ;
	[ "groups"          ; $groups          ; JSONArray  ] ;
	[ "groupCount"      ; $groupCount      ; JSONNumber ] ;
	[ "stavkeCount"     ; $totalStavke     ; JSONNumber ] ;
	[ "callbackScript"  ; $callbackScript  ; JSONString ] ;
	[ "callbackContext" ; If ( IsEmpty ( $callbackContext ) ; JSONSetElement ( "{}" ; "serviceOrderID" ; $serviceOrderID ; JSONString ) ; $callbackContext ) ; JSONObject ]
