<Text>MARK: Test5 CreateNewArtikal</Text>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$testName</Name>
<Value><Calculation><![CDATA["5 create mode, new artikal, kolicina 5"]]></Calculation></Value>
</Step>
<Step enable="True" id="1" name="Perform Script">
<Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "sifra" ; $testSifra ; JSONString ] ;
	[ "primkaID" ; $fxPrimka ; JSONString ] ;
	[ "kolicina" ; 5 ; JSONNumber ]
)]]></Calculation>
<Script id="0" name="ORD__AddArticle"/>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$actual</Name>
<Value><Calculation><![CDATA[Get ( ScriptResult )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$errData</Name>
<Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "lastError" ; Get ( LastError ) ; JSONNumber ] ;
