<Name>$artikalID</Name>
<Value><Calculation><![CDATA[JSONGetElement ( $actual ; "data.artikalID" )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$t5Stavka</Name>
<Value><Calculation><![CDATA[JSONGetElement ( $actual ; "data.stavkaID" )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT \"ForeignKeyPrimkaID\", \"ForeignKeyArtikalID\", \"Kolicina\" FROM \"StavkePrimke\" WHERE \"PrimaryKey\" = ?" ;
	"useSQLResult=row" ;
	$t5Stavka
)]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$rowOk</Name>
<Value><Calculation><![CDATA[epSQLResultRowCount ( "row" ) = 1
and epSQLResult ( 0 ; 0 ; "row" ) = $fxPrimka
and epSQLResult ( 0 ; 1 ; "row" ) = $artikalID
and GetAsNumber ( epSQLResult ( 0 ; 2 ; "row" ) ) = 5]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[epSQLResultDelete ( "row" )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[epSQLExecute ( "SELECT \"SifraArtikla\" FROM \"Artikli\" WHERE \"PrimaryKey\" = ?" ; "useSQLResult=art" ; $artikalID )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$artOk</Name>
<Value><Calculation><![CDATA[epSQLResultRowCount ( "art" ) = 1
and epSQLResult ( 0 ; 0 ; "art" ) = $testSifra]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[epSQLResultDelete ( "art" )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$pass</Name>
<Value><Calculation><![CDATA[Let ( [
		~created = JSONGetElement ( $actual ; "data.artikalCreated" ) ;
		~stCreated = JSONGetElement ( $actual ; "data.stavkaCreated" )
	] ;
	JSONGetElement ( $actual ; "status" ) = "success"
	and ( ~created = 1 or ~created = "true" )
	and ( ~stCreated = 1 or ~stCreated = "true" )
	and $rowOk
	and $artOk
)]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$testCount</Name>
<Value><Calculation><![CDATA[$testCount + 1]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$passCount</Name>
<Value><Calculation><![CDATA[$passCount + If ( $pass ; 1 ; 0 )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$results</Name>
<Value><Calculation><![CDATA[JSONSetElement ( $results ; "[" & $testCount - 1 & "]" ; JSONSetElement ( "{}" ;
	[ "test" ; $testName ; JSONString ] ;
	[ "pass" ; $pass ; JSONBoolean ] ;
	[ "expected" ; "success, artikalCreated, stavkaCreated, row FKs + Kolicina=5, sifra stored uppercase" ; JSONString ] ;
	[ "actual" ; If ( IsEmpty ( $actual ) ; "(empty)" ; $actual ) & " | rowOk=" & $rowOk & " artOk=" & $artOk ; JSONString ] ;
	[ "errData" ; $errData ; JSONRaw ]
) ; JSONRaw )]]></Calculation></Value>
</Step>
