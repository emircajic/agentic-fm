<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Spoji sve fiskalizirane fakture firme A za izabrani mjesec/godinu u jedan PDF za knjigovođu. Rezultat ide u Globals::MergedPDF i kao fajl na Desktop. Bez tvrdo kodiranog imena diska / homebrew putanje; čisti za sobom temp fajlove.</Text>
	</Step>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Predloži prošli mjesec, pa pitaj korisnika</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$lastMonthEnd</Name>
		<Value><Calculation><![CDATA[Date ( Month ( Get ( CurrentDate ) ) ; 0 ; Year ( Get ( CurrentDate ) ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[Month ( $lastMonthEnd )]]></Calculation>
		<Field table="Globals" id="47" name="MergeMonth"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[Year ( $lastMonthEnd )]]></Calculation>
		<Field table="Globals" id="48" name="MergeYear"/>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Spoji fakture"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Za koji mjesec i godinu spojiti fiskalizirane fakture?"]]></Calculation></Message>
		<Buttons>
			<Button CommitState="True"><Calculation><![CDATA["OK"]]></Calculation></Button>
			<Button CommitState="False"><Calculation><![CDATA["Odustani"]]></Calculation></Button>
		</Buttons>
		<InputFields>
			<InputField UsePasswordCharacter="False">
				<Field table="Globals" id="47" name="MergeMonth"/>
				<Label><Calculation><![CDATA["Mjesec (1-12)"]]></Calculation></Label>
			</InputField>
			<InputField UsePasswordCharacter="False">
				<Field table="Globals" id="48" name="MergeYear"/>
				<Label><Calculation><![CDATA["Godina"]]></Calculation></Label>
			</InputField>
		</InputFields>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( LastMessageChoice ) <> 1]]></Calculation>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Validacija unosa</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$month</Name>
		<Value><Calculation><![CDATA[GetAsNumber ( Globals::MergeMonth )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$year</Name>
		<Value><Calculation><![CDATA[GetAsNumber ( Globals::MergeYear )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$month < 1 or $month > 12 or $year < 2000 or $year > 2100]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Greška"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Unesite mjesec (1-12) i ispravnu godinu."]]></Calculation></Message>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$monthPad</Name>
		<Value><Calculation><![CDATA[Right ( "0" & $month ; 2 )]]></Calculation></Value>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Pronađi fiskalizirane fakture firme A za taj mjesec + godinu</Text>
	</Step>
	<Step enable="True" id="6" name="Go to Layout">
		<LayoutDestination value="SelectedLayout"/>
		<Layout id="171" name="Invoices"/>
		<Animation value=""/>
	</Step>
	<Step enable="True" id="22" name="Enter Find Mode">
		<Pause state="False"/>
		<Restore state="False"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA["A-" & $monthPad & "-*"]]></Calculation>
		<Field table="Invoices" id="6" name="BrojFakture"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA["*"]]></Calculation>
		<Field table="Invoices" id="7" name="BrojFiskalnogRacuna"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[GetAsText ( Date ( 1 ; 1 ; $year ) ) & "..." & GetAsText ( Date ( 12 ; 31 ; $year ) )]]></Calculation>
		<Field table="Invoices" id="10" name="Datum"/>
	</Step>
	<Step enable="True" id="28" name="Perform Find">
		<Restore state="False"/>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( FoundCount ) = 0]]></Calculation>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Nema faktura"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Nema fiskaliziranih faktura za " & $monthPad & "/" & $year & "."]]></Calculation></Message>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="39" name="Sort Records">
		<NoInteract state="True"/>
		<Restore state="True"/>
		<SortList Maintain="True" value="True">
			<Sort type="Ascending">
				<PrimaryField>
					<Field table="Invoices" id="6" name="BrojFakture"/>
				</PrimaryField>
			</Sort>
		</SortList>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Putanje — POSIX se izvodi skidanjem imena diska (radi na svakom Macu)</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$tempFM</Name>
		<Value><Calculation><![CDATA[Get ( TemporaryPath )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$tempPosix</Name>
		<Value><Calculation><![CDATA[Middle ( $tempFM ; Position ( $tempFM ; "/" ; 1 ; 2 ) ; 10000000 )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$runId</Name>
		<Value><Calculation><![CDATA["merge_" & Substitute ( Get ( UUID ) ; "-" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$runFM</Name>
		<Value><Calculation><![CDATA[$tempFM & $runId & "/"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$runPosix</Name>
		<Value><Calculation><![CDATA[$tempPosix & $runId & "/"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$deskPosix</Name>
		<Value><Calculation><![CDATA[Middle ( Get ( DesktopPath ) ; Position ( Get ( DesktopPath ) ; "/" ; 1 ; 2 ) ; 10000000 )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$outName</Name>
		<Value><Calculation><![CDATA["Fakture-" & $year & "-" & $monthPad & ".pdf"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$outPosix</Name>
		<Value><Calculation><![CDATA[$deskPosix & $outName]]></Calculation></Value>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Izvezi svaki PDF u jedinstveni temp folder</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$pagesArg</Name>
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$exported</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$errors</Name>
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
	</Step>
	<Step enable="True" id="16" name="Go to Record/Request/Page">
		<RowPageLocation value="First"/>
	</Step>
	<Step enable="True" id="71" name="Loop">
		<FlushType value="Always"/>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( Invoices::PDFFile )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$n</Name>
		<Value><Calculation><![CDATA[$exported + 1]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$pad</Name>
		<Value><Calculation><![CDATA[Right ( "0000" & $n ; 4 )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$fileFM</Name>
		<Value><Calculation><![CDATA[$runFM & $pad & ".pdf"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$filePosix</Name>
		<Value><Calculation><![CDATA[$runPosix & $pad & ".pdf"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="132" name="Export Field Contents">
		<CreateDirectories state="True"/>
		<AutoOpen state="False"/>
		<CreateEmail state="False"/>
		<UniversalPathList>$fileFM</UniversalPathList>
		<Field table="Invoices" id="30" name="PDFFile"/>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( LastError ) = 0]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$pagesArg</Name>
		<Value><Calculation><![CDATA[$pagesArg & " " & Quote ( $filePosix ) & " 1-z"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$exported</Name>
		<Value><Calculation><![CDATA[$n]]></Calculation></Value>
	</Step>
	<Step enable="True" id="69" name="Else"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$errors</Name>
		<Value><Calculation><![CDATA[List ( $errors ; "Izvoz neuspio: red " & Get ( RecordNumber ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="16" name="Go to Record/Request/Page">
		<RowPageLocation value="Next"/>
		<Exit state="True"/>
	</Step>
	<Step enable="True" id="73" name="End Loop"/>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$exported = 0]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$cleanup</Name>
		<Value><Calculation><![CDATA[BE_ExecuteSystemCommand ( "rm -rf " & Quote ( $runPosix ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Nema PDF-ova"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Nijedna pronađena faktura nema priložen PDF."]]></Calculation></Message>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[""]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Spoji preko qpdf — sam se pronađe (Intel /usr/local ili Apple Silicon /opt/homebrew)</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$cmd</Name>
		<Value><Calculation><![CDATA["QPDF=\"\"; for p in /opt/homebrew/bin/qpdf /usr/local/bin/qpdf; do [ -x \"$p\" ] && QPDF=\"$p\" && break; done; [ -z \"$QPDF\" ] && { echo QPDF_NOT_FOUND; exit 127; }; \"$QPDF\" --empty --pages" & $pagesArg & " -- " & Quote ( $outPosix ) & " 2>&1"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$result</Name>
		<Value><Calculation><![CDATA[BE_ExecuteSystemCommand ( $cmd ; -1 )]]></Calculation></Value>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Uvezi rezultat + počisti temp folder</Text>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[BE_FileExists ( $outPosix )]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[BE_FileImport ( $outPosix )]]></Calculation>
		<Field table="Globals" id="36" name="MergedPDF"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$cleanup</Name>
		<Value><Calculation><![CDATA[BE_ExecuteSystemCommand ( "rm -rf " & Quote ( $runPosix ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="6" name="Go to Layout">
		<LayoutDestination value="SelectedLayout"/>
		<Layout id="255" name="MergedPDFs"/>
		<Animation value=""/>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["Gotovo"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Spojeno " & $exported & " faktura." & ¶ & "Sačuvano na Desktop: " & $outName & If ( not IsEmpty ( $errors ) ; ¶ & ¶ & "Upozorenja:" & ¶ & $errors )]]></Calculation></Message>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[$outPosix]]></Calculation>
	</Step>
	<Step enable="True" id="69" name="Else"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$cleanup</Name>
		<Value><Calculation><![CDATA[BE_ExecuteSystemCommand ( "rm -rf " & Quote ( $runPosix ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="87" name="Show Custom Dialog">
		<Title><Calculation><![CDATA["qpdf greška"]]></Calculation></Title>
		<Message><Calculation><![CDATA["Spajanje nije uspjelo." & ¶ & $result & If ( not IsEmpty ( $errors ) ; ¶ & ¶ & $errors )]]></Calculation></Message>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[False]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

</fmxmlsnippet>
