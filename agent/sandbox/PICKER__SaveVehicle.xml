<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Create or update a vehicle from the Client/Vehicle picker web viewer, then push the result back to JS via receiveVehicleSaved.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMETER (JSON): mode (create|update), vehicleId (update only), manufacturer, model, year, vin, plate, clientId (create only — optional owner)&#xD;RETURNS (to JS receiveVehicleSaved): { vehicle: {...} } or { error: "..." }</Text>
		<Field>$README</Field>
	</Step>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Parse parameter</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$json</Name>
		<Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$mode</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "mode" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$vehicleId</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "vehicleId" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$manufacturer</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "manufacturer" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$model</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "model" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$year</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "year" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$vin</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "vin" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$plate</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "plate" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$clientId</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "clientId" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$mode = "update"]]></Calculation>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: UPDATE existing vehicle via epSQL</Text>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoInteract state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"UPDATE Vehicles SET Manufacturer = ?, Model = ?, YearManufactured = ?, VIN = ?, PlateNumber = ? WHERE PrimaryKey = ?" ;
	"" ;
	$manufacturer ; $model ; GetAsNumber ( $year ) ; $vin ; $plate ; $vehicleId
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
		<ObjectName><Calculation><![CDATA["clientvehiclepicker"]]></Calculation></ObjectName>
		<FunctionName><Calculation><![CDATA["receiveVehicleSaved"]]></Calculation></FunctionName>
		<Parameters Count="1">
			<P><Calculation><![CDATA[JSONSetElement ( "{}" ; "error" ; $err ; JSONString )]]></Calculation></P>
		</Parameters>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "error" ; $err ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$vehicle</Name>
		<Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "PrimaryKey" ; $vehicleId ; JSONString ] ;
	[ "Manufacturer" ; $manufacturer ; JSONString ] ;
	[ "Model" ; $model ; JSONString ] ;
	[ "YearManufactured" ; GetAsNumber ( $year ) ; JSONNumber ] ;
	[ "VIN" ; $vin ; JSONString ] ;
	[ "PlateNumber" ; $plate ; JSONString ]
)]]></Calculation></Value>
	</Step>

	<Step enable="True" id="69" name="Else"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: CREATE new vehicle</Text>
	</Step>
	<Step enable="True" id="6" name="Go to Layout">
		<LayoutDestination value="SelectedLayout"/>
		<Layout id="104" name="Dev Vehicles"/>
		<Animation value=""/>
	</Step>
	<Step enable="True" id="7" name="New Record/Request"/>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$manufacturer]]></Calculation>
		<Field table="Vehicles" id="7" name="Manufacturer"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$model]]></Calculation>
		<Field table="Vehicles" id="8" name="Model"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[GetAsNumber ( $year )]]></Calculation>
		<Field table="Vehicles" id="9" name="YearManufactured"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$vin]]></Calculation>
		<Field table="Vehicles" id="6" name="VIN"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$plate]]></Calculation>
		<Field table="Vehicles" id="15" name="PlateNumber"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$clientId]]></Calculation>
		<Field table="Vehicles" id="10" name="ForeignKeyClient"/>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoInteract state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$vehicle</Name>
		<Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "PrimaryKey" ; Vehicles::PrimaryKey ; JSONString ] ;
	[ "Manufacturer" ; Vehicles::Manufacturer ; JSONString ] ;
	[ "Model" ; Vehicles::Model ; JSONString ] ;
	[ "YearManufactured" ; Vehicles::YearManufactured ; JSONNumber ] ;
	[ "VIN" ; Vehicles::VIN ; JSONString ] ;
	[ "PlateNumber" ; Vehicles::PlateNumber ; JSONString ] ;
	[ "ForeignKeyClient" ; Vehicles::ForeignKeyClient ; JSONString ]
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="6" name="Go to Layout">
		<LayoutDestination value="SelectedLayout"/>
		<Layout id="270" name="SO__ClientVehiclePicker"/>
		<Animation value=""/>
	</Step>

	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Return to picker</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$payload</Name>
		<Value><Calculation><![CDATA[JSONSetElement ( "{}" ; "vehicle" ; $vehicle ; JSONObject )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
		<ObjectName><Calculation><![CDATA["clientvehiclepicker"]]></Calculation></ObjectName>
		<FunctionName><Calculation><![CDATA["receiveVehicleSaved"]]></Calculation></FunctionName>
		<Parameters Count="1">
			<P><Calculation><![CDATA[$payload]]></Calculation></P>
		</Parameters>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[$payload]]></Calculation>
	</Step>

</fmxmlsnippet>
