<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Create ServiceOrderLines records for each selected StavkePrimke, linking them to the service order. Pure SQL — no layout hops.</Text>
	</Step>

	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS: serviceOrderID (text, required) | stavkePKs (JSONArray of StavkePrimke PKs, required)
RETURNS: data.createdCount (number)</Text>
		<Field table="" id="0" name="$README"/>
	</Step>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>

	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="On"/>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "serviceOrderID|stavkePKs" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$createdCount</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SO_ATTACH_START" ; "Attaching stavke to serviceOrderID: " & $serviceOrderID ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Validate params ───────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $serviceOrderID )]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "serviceOrderID is required" ; "serviceOrderID" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $stavkePKs ) or ValueCount ( JSONListKeys ( $stavkePKs ; "" ) ) = 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "stavkePKs is required and must not be empty" ; "stavkePKs" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Response_HasErrors ( $response )]]></Calculation>
	</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="1" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Verify ServiceOrder exists — single SELECT, no layout hop ─────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$selSO</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT \"PrimaryKey\" FROM \"ServiceOrders\" WHERE \"PrimaryKey\" = ?" ;
	"useSQLResult=so" ;
	$serviceOrderID
)]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $selSO ) or epSQLResultRowCount ( "so" ) = 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[epSQLResultDelete ( "so" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "NOT_FOUND_SO" ; "ServiceOrder not found: " & $serviceOrderID ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="1" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "so" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Loop stavkePKs — for each: SELECT stavka details, compute available qty, INSERT line ──</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$count</Name>
		<Value><Calculation><![CDATA[ValueCount ( JSONListKeys ( $stavkePKs ; "" ) )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>

	<Step enable="True" id="71" name="Loop">
		<FlushType value="Always"/>
	</Step>
		<Step enable="True" id="72" name="Exit Loop If">
			<Calculation><![CDATA[$i >= $count]]></Calculation>
		</Step>

		<Step enable="True" id="141" name="Set Variable">
			<Name>$stavkaPK</Name>
			<Value><Calculation><![CDATA[JSONGetElement ( $stavkePKs ; "[" & $i & "]" )]]></Calculation></Value>
		</Step>

		<Step enable="True" id="89" name="# (comment)">
			<Text>Look up StavkaPrimke + Artikli in one shot.</Text>
		</Step>

		<Step enable="True" id="141" name="Set Variable">
			<Name>$selSt</Name>
			<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT sp.\"ForeignKeyArtikalID\", sp.\"Kolicina\", sp.\"ProdajnaCijena\", sp.\"NabavnaCijenaStavke\", sp.\"JM\", sp.\"ForeignKeyPrimkaID\", a.\"NazivArtikla\"
	 FROM \"StavkePrimke\" sp
	 LEFT JOIN \"Artikli\" a ON sp.\"ForeignKeyArtikalID\" = a.\"PrimaryKey\"
	 WHERE sp.\"PrimaryKey\" = ?" ;
	"useSQLResult=stavka" ;
	$stavkaPK
)]]></Calculation></Value>
		</Step>

		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[not IsEmpty ( $selSt ) or epSQLResultRowCount ( "stavka" ) = 0]]></Calculation>
		</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$void</Name>
				<Value><Calculation><![CDATA[epSQLResultDelete ( "stavka" )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$void</Name>
				<Value><Calculation><![CDATA[Response_AddWarning ( "NOT_FOUND_STAVKA" ; "StavkaPrimke not found: " & $stavkaPK ; "" ; JSONSetElement ( "{}" ; "stavkaPK" ; $stavkaPK ; JSONString ) ; "" )]]></Calculation></Value>
			</Step>
		<Step enable="True" id="125" name="Else"/>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$artikalPK</Name>
				<Value><Calculation><![CDATA[epSQLResult ( 0 ; 0 ; "stavka" )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$kolicina</Name>
				<Value><Calculation><![CDATA[GetAsNumber ( epSQLResult ( 0 ; 1 ; "stavka" ) )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$rate</Name>
				<Value><Calculation><![CDATA[GetAsNumber ( epSQLResult ( 0 ; 2 ; "stavka" ) )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$nabavna</Name>
				<Value><Calculation><![CDATA[GetAsNumber ( epSQLResult ( 0 ; 3 ; "stavka" ) )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$jm</Name>
				<Value><Calculation><![CDATA[epSQLResult ( 0 ; 4 ; "stavka" )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$primkaPK</Name>
				<Value><Calculation><![CDATA[epSQLResult ( 0 ; 5 ; "stavka" )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$naziv</Name>
				<Value><Calculation><![CDATA[epSQLResult ( 0 ; 6 ; "stavka" )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$void</Name>
				<Value><Calculation><![CDATA[epSQLResultDelete ( "stavka" )]]></Calculation></Value>
			</Step>

			<Step enable="True" id="89" name="# (comment)">
				<Text>Compute available qty — replicate QtyAvailable_Calculation via two SUM queries.</Text>
			</Step>

			<Step enable="True" id="141" name="Set Variable">
				<Name>$selT</Name>
				<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT SUM(\"Qty\") FROM \"ServiceOrderLines\" WHERE \"ForeignKeyStavkaPrimkeID\" = ?" ;
	"useSQLResult=txfr" ;
	$stavkaPK
)]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$transferred</Name>
				<Value><Calculation><![CDATA[If ( not IsEmpty ( $selT ) or epSQLResultRowCount ( "txfr" ) = 0 ;
	0 ;
	GetAsNumber ( epSQLResult ( 0 ; 0 ; "txfr" ) )
)]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$void</Name>
				<Value><Calculation><![CDATA[epSQLResultDelete ( "txfr" )]]></Calculation></Value>
			</Step>

			<Step enable="True" id="141" name="Set Variable">
				<Name>$selR</Name>
				<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT SUM(\"Kolicina\") FROM \"StavkePovrata\" WHERE \"ForeignKeyStavkaPrimkeID\" = ?" ;
	"useSQLResult=rtrn" ;
	$stavkaPK
)]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$returned</Name>
				<Value><Calculation><![CDATA[If ( not IsEmpty ( $selR ) or epSQLResultRowCount ( "rtrn" ) = 0 ;
	0 ;
	GetAsNumber ( epSQLResult ( 0 ; 0 ; "rtrn" ) )
)]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$void</Name>
				<Value><Calculation><![CDATA[epSQLResultDelete ( "rtrn" )]]></Calculation></Value>
			</Step>

			<Step enable="True" id="141" name="Set Variable">
				<Name>$qty</Name>
				<Value><Calculation><![CDATA[Max ( 0 ; $kolicina - $transferred - $returned )]]></Calculation></Value>
			</Step>

			<Step enable="True" id="68" name="If">
				<Calculation><![CDATA[$qty ≤ 0]]></Calculation>
			</Step>
				<Step enable="True" id="141" name="Set Variable">
					<Name>$void</Name>
					<Value><Calculation><![CDATA[Response_AddWarning ( "NO_QTY_AVAILABLE" ; "StavkaPrimke has no available quantity: " & $stavkaPK ; "" ; JSONSetElement ( "{}" ; "stavkaPK" ; $stavkaPK ; JSONString ) ; "" )]]></Calculation></Value>
				</Step>
			<Step enable="True" id="125" name="Else"/>
				<Step enable="True" id="89" name="# (comment)">
					<Text>INSERT new ServiceOrderLine — pure SQL, no layout context.</Text>
				</Step>
				<Step enable="True" id="141" name="Set Variable">
					<Name>$newLinePK</Name>
					<Value><Calculation><![CDATA[Get ( UUID )]]></Calculation></Value>
				</Step>
				<Step enable="True" id="141" name="Set Variable">
					<Name>$ins</Name>
					<Value><Calculation><![CDATA[epSQLExecute (
	"INSERT INTO \"ServiceOrderLines\"
	 (\"PrimaryKey\", \"ForeignKeyServiceOrder\", \"ForeignKeyArtikalID\", \"Description\",
	  \"Qty\", \"Rate\", \"NabavnaCijena_Stvarna\", \"JM\", \"ForeignKeyPrimkaID\", \"ForeignKeyStavkaPrimkeID\")
	 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)" ;
	"" ;
	$newLinePK ;
	$serviceOrderID ;
	$artikalPK ;
	$naziv ;
	$qty ;
	$rate ;
	$nabavna ;
	$jm ;
	$primkaPK ;
	$stavkaPK
)]]></Calculation></Value>
				</Step>
				<Step enable="True" id="68" name="If">
					<Calculation><![CDATA[IsEmpty ( $ins )]]></Calculation>
				</Step>
					<Step enable="True" id="141" name="Set Variable">
						<Name>$createdCount</Name>
						<Value><Calculation><![CDATA[$createdCount + 1]]></Calculation></Value>
					</Step>
				<Step enable="True" id="125" name="Else"/>
					<Step enable="True" id="141" name="Set Variable">
						<Name>$void</Name>
						<Value><Calculation><![CDATA[Response_AddWarning ( "INSERT_FAILED" ; "Failed to create line for stavka: " & $stavkaPK & " (" & $ins & ")" ; "" ; JSONSetElement ( "{}" ; "stavkaPK" ; $stavkaPK ; JSONString ) ; "" )]]></Calculation></Value>
					</Step>
				<Step enable="True" id="70" name="End If"/>
			<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="70" name="End If"/>

		<Step enable="True" id="141" name="Set Variable">
			<Name>$i</Name>
			<Value><Calculation><![CDATA[$i + 1]]></Calculation></Value>
		</Step>
	<Step enable="True" id="73" name="End Loop"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Result ────────────────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$createdCount = 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "NO_LINES_CREATED" ; "No ServiceOrderLines were successfully created" ; "" ; $params ; "" )]]></Calculation></Value>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ; "createdCount" ; $createdCount ; JSONNumber ) )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SO_ATTACH_DONE" ; "Created " & $createdCount & " of " & $count & " lines" ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
		<Step enable="True" id="1" name="Perform Script">
			<Script id="780" name="UTIL__FlushLog"/>
			<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
