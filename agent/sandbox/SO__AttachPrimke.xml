<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">

  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Create ServiceOrderLines records for each selected StavkePrimke, linking them to the service order.</Text>
  </Step>
  <Step enable="False" id="61" name="Insert Text">
    <SelectAll state="False"/>
    <Text>PARAMS: serviceOrderID (text, required) | stavkePKs (JSONArray of StavkePrimke PKs, required)&#xD;RETURNS: data.createdCount (number)</Text>
    <Field>$README</Field>
  </Step>

  <Step enable="True" id="85" name="Allow User Abort">
    <Boolean type="AllowUserAbort" id="0" value="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Boolean type="SetErrorCapture" id="0" value="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Name>$void</Name>
    <Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "serviceOrderID|stavkePKs" )]]></Calculation></Value>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Name>$void</Name>
    <Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Name>$createdCount</Name>
    <Value><Calculation><![CDATA[0]]></Calculation></Value>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Name>$void</Name>
    <Value><Calculation><![CDATA[Log.add ( "info" ; "SO_ATTACH_START" ; "Attaching stavke to serviceOrderID: " & $serviceOrderID ; $params )]]></Calculation></Value>
  </Step>

  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Validate</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $serviceOrderID )]]></Calculation>
  </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Name>$void</Name>
      <Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "serviceOrderID is required" ; "serviceOrderID" ; "{}" ; "" )]]></Calculation></Value>
    </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $stavkePKs ) or ValueCount ( JSONListKeys ( $stavkePKs ; "" ) ) = 0]]></Calculation>
  </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Name>$void</Name>
      <Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "stavkePKs is required and must not be empty" ; "stavkePKs" ; "{}" ; "" )]]></Calculation></Value>
    </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Response_HasErrors ( $response )]]></Calculation>
  </Step>
    <Step enable="True" id="68" name="If">
      <Restore state="False"/>
      <Calculation><![CDATA[$isRoot]]></Calculation>
    </Step>
      <Step enable="True" id="1" name="Perform Script">
        <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
        <Script id="780" name="UTIL__FlushLog"/>
      </Step>
    <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[Response_Finalize]]></Calculation>
    </Step>
  <Step enable="True" id="70" name="End If"/>

  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Verify ServiceOrder exists</Text>
  </Step>
  <Step enable="True" id="6" name="Go to Layout">
    <Layout id="29" name="Dev Service Orders"/>
  </Step>
  <Step enable="True" id="22" name="Enter Find Mode">
    <Pause state="False"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Field table="ServiceOrders" id="1" name="PrimaryKey"/>
    <Calculation><![CDATA[$serviceOrderID]]></Calculation>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[Get ( FoundCount ) = 0]]></Calculation>
  </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Name>$void</Name>
      <Value><Calculation><![CDATA[Response_AddError ( "NOT_FOUND_SO" ; "ServiceOrder not found: " & $serviceOrderID ; "" ; "{}" ; "" )]]></Calculation></Value>
    </Step>
    <Step enable="True" id="68" name="If">
      <Restore state="False"/>
      <Calculation><![CDATA[$isRoot]]></Calculation>
    </Step>
      <Step enable="True" id="1" name="Perform Script">
        <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
        <Script id="780" name="UTIL__FlushLog"/>
      </Step>
    <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[Response_Finalize]]></Calculation>
    </Step>
  <Step enable="True" id="70" name="End If"/>

  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Loop stavkePKs — find each stavka and create a ServiceOrderLines record</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Name>$count</Name>
    <Value><Calculation><![CDATA[ValueCount ( JSONListKeys ( $stavkePKs ; "" ) )]]></Calculation></Value>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Name>$i</Name>
    <Value><Calculation><![CDATA[0]]></Calculation></Value>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
    <Step enable="True" id="72" name="Exit Loop If">
      <Calculation><![CDATA[$i >= $count]]></Calculation>
    </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Name>$stavkaPK</Name>
      <Value><Calculation><![CDATA[JSONGetElement ( $stavkePKs ; "[" & $i & "]" )]]></Calculation></Value>
    </Step>

    <Step enable="True" id="6" name="Go to Layout">
      <Layout id="227" name="Dev StavkePrimke"/>
    </Step>
    <Step enable="True" id="22" name="Enter Find Mode">
      <Pause state="False"/>
    </Step>
    <Step enable="True" id="76" name="Set Field">
      <Field table="StavkePrimke" id="1" name="PrimaryKey"/>
      <Calculation><![CDATA[$stavkaPK]]></Calculation>
    </Step>
    <Step enable="True" id="28" name="Perform Find">
      <Restore state="False"/>
    </Step>

    <Step enable="True" id="68" name="If">
      <Restore state="False"/>
      <Calculation><![CDATA[Get ( FoundCount ) = 0]]></Calculation>
    </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Name>$void</Name>
        <Value><Calculation><![CDATA[Response_AddWarning ( "NOT_FOUND_STAVKA" ; "StavkaPrimke not found: " & $stavkaPK ; "" ; JSONSetElement ( "{}" ; "stavkaPK" ; $stavkaPK ; JSONString ) ; "" )]]></Calculation></Value>
      </Step>
    <Step enable="True" id="125" name="Else If">
      <Restore state="False"/>
      <Calculation><![CDATA[StavkePrimke::QtyAvailable_Calculation ≤ 0]]></Calculation>
    </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Name>$void</Name>
        <Value><Calculation><![CDATA[Response_AddWarning ( "NO_QTY_AVAILABLE" ; "StavkaPrimke has no available quantity: " & $stavkaPK ; "" ; JSONSetElement ( "{}" ; "stavkaPK" ; $stavkaPK ; JSONString ) ; "" )]]></Calculation></Value>
      </Step>
    <Step enable="True" id="69" name="Else"/>
      <Step enable="True" id="141" name="Set Variable">
        <Name>$artikalPK</Name>
        <Value><Calculation><![CDATA[StavkePrimke::ForeignKeyArtikalID]]></Calculation></Value>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Name>$naziv</Name>
        <Value><Calculation><![CDATA[Artikli::NazivArtikla]]></Calculation></Value>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Name>$qty</Name>
        <Value><Calculation><![CDATA[StavkePrimke::QtyAvailable_Calculation]]></Calculation></Value>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Name>$rate</Name>
        <Value><Calculation><![CDATA[StavkePrimke::ProdajnaCijena]]></Calculation></Value>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Name>$nabavna</Name>
        <Value><Calculation><![CDATA[StavkePrimke::NabavnaCijenaStavke]]></Calculation></Value>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Name>$jm</Name>
        <Value><Calculation><![CDATA[StavkePrimke::JM]]></Calculation></Value>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Name>$primkaPK</Name>
        <Value><Calculation><![CDATA[StavkePrimke::ForeignKeyPrimkaID]]></Calculation></Value>
      </Step>

      <Step enable="True" id="6" name="Go to Layout">
        <Layout id="31" name="Dev Service Order Lines"/>
      </Step>
      <Step enable="True" id="7" name="New Record/Request"/>
      <Step enable="True" id="76" name="Set Field">
        <Field table="ServiceOrderLines" id="28" name="ForeignKeyServiceOrder"/>
        <Calculation><![CDATA[$serviceOrderID]]></Calculation>
      </Step>
      <Step enable="True" id="76" name="Set Field">
        <Field table="ServiceOrderLines" id="49" name="ForeignKeyArtikalID"/>
        <Calculation><![CDATA[$artikalPK]]></Calculation>
      </Step>
      <Step enable="True" id="76" name="Set Field">
        <Field table="ServiceOrderLines" id="41" name="Description"/>
        <Calculation><![CDATA[$naziv]]></Calculation>
      </Step>
      <Step enable="True" id="76" name="Set Field">
        <Field table="ServiceOrderLines" id="32" name="Qty"/>
        <Calculation><![CDATA[$qty]]></Calculation>
      </Step>
      <Step enable="True" id="76" name="Set Field">
        <Field table="ServiceOrderLines" id="34" name="Rate"/>
        <Calculation><![CDATA[$rate]]></Calculation>
      </Step>
      <Step enable="True" id="76" name="Set Field">
        <Field table="ServiceOrderLines" id="50" name="NabavnaCijena_Stvarna"/>
        <Calculation><![CDATA[$nabavna]]></Calculation>
      </Step>
      <Step enable="True" id="76" name="Set Field">
        <Field table="ServiceOrderLines" id="60" name="JM"/>
        <Calculation><![CDATA[$jm]]></Calculation>
      </Step>
      <Step enable="True" id="76" name="Set Field">
        <Field table="ServiceOrderLines" id="51" name="ForeignKeyPrimkaID"/>
        <Calculation><![CDATA[$primkaPK]]></Calculation>
      </Step>
      <Step enable="True" id="76" name="Set Field">
        <Field table="ServiceOrderLines" id="52" name="ForeignKeyStavkaPrimkeID"/>
        <Calculation><![CDATA[$stavkaPK]]></Calculation>
      </Step>
      <Step enable="True" id="75" name="Commit Records/Requests">
        <NoInteract state="True"/>
      </Step>
      <Step enable="True" id="68" name="If">
        <Restore state="False"/>
        <Calculation><![CDATA[Get ( LastError ) = 0]]></Calculation>
      </Step>
        <Step enable="True" id="141" name="Set Variable">
          <Name>$createdCount</Name>
          <Value><Calculation><![CDATA[$createdCount + 1]]></Calculation></Value>
        </Step>
      <Step enable="True" id="69" name="Else"/>
        <Step enable="True" id="141" name="Set Variable">
          <Name>$void</Name>
          <Value><Calculation><![CDATA[Response_AddWarning ( "COMMIT_FAILED" ; "Failed to create line for stavka: " & $stavkaPK & " (FM error " & Get ( LastError ) & ")" ; "" ; JSONSetElement ( "{}" ; "stavkaPK" ; $stavkaPK ; JSONString ) ; "" )]]></Calculation></Value>
        </Step>
      <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="70" name="End If"/>

    <Step enable="True" id="141" name="Set Variable">
      <Name>$i</Name>
      <Value><Calculation><![CDATA[$i + 1]]></Calculation></Value>
    </Step>
  <Step enable="True" id="73" name="End Loop"/>

  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Result</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$createdCount = 0]]></Calculation>
  </Step>
    <Step enable="True" id="141" name="Set Variable">
      <Name>$void</Name>
      <Value><Calculation><![CDATA[Response_AddError ( "NO_LINES_CREATED" ; "No ServiceOrderLines were successfully created" ; "" ; $params ; "" )]]></Calculation></Value>
    </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Name>$void</Name>
    <Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ; "createdCount" ; $createdCount ; JSONNumber ) )]]></Calculation></Value>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Name>$void</Name>
    <Value><Calculation><![CDATA[Log.add ( "info" ; "SO_ATTACH_DONE" ; "Created " & $createdCount & " of " & $count & " lines" ; $params )]]></Calculation></Value>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
    <Step enable="True" id="1" name="Perform Script">
      <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
      <Script id="780" name="UTIL__FlushLog"/>
    </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>

</fmxmlsnippet>
