<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Load a page of ServiceOrders for the SO picker. Runs locally; called from web viewer.
Builds dynamic SQL with JOINs to Clients, Vehicles, Staff. Returns results to wv_SOPicker.</Text>
  </Step>
  <Step enable="False" id="61" name="Insert Text">
    <SelectAll state="False"/>
    <Text>PARAMS:
  filter       (text) — searches SO#, plate, client name, description
  statuses     (array of text) — e.g. ["Otvoren","U toku"]; empty = no status filter
  dateRanges   (array of {from,to} YYYY-MM-DD) — ORed together; empty = no date filter
  offset       (number) — 0-based page offset
  limit        (number) — records per page, default 20
  requestGen   (text) — echoed back; stale responses discarded by web viewer</Text>
    <Field>$README</Field>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$params</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $params ; "filter" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$filter</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $params ; "statuses" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$statuses</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $params ; "dateRanges" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$dateRanges</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsNumber ( JSONGetElement ( $params ; "offset" ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$offset</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( $l = GetAsNumber ( JSONGetElement ( $params ; "limit" ) ) ; If ( $l > 0 ; $l ; 20 ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$limit</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $params ; "requestGen" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$requestGen</Name>
  </Step>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Build WHERE clause — status filter</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[""]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$conditions</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ValueCount ( JSONListKeys ( $statuses ; "" ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$statusCount</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$statusCount > 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["so.Status IN ("]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$statusClause</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$i >= $statusCount]]></Calculation>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$i > 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$statusClause & ", "]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$statusClause</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$statusClause & "'" & JSONGetElement ( $statuses ; $i ) & "'"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$statusClause</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$i + 1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$statusClause & ")"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$conditions</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Date range filter (ORed)</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ValueCount ( JSONListKeys ( $dateRanges ; "" ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$dateCount</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$dateCount > 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["("]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$dateClause</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$i >= $dateCount]]></Calculation>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$i > 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$dateClause & " OR "]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$dateClause</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$dateClause &
"so.JobDate BETWEEN DATE '" & JSONGetElement ( $dateRanges ; "[" & $i & "].from" ) &
"' AND DATE '" & JSONGetElement ( $dateRanges ; "[" & $i & "].to" ) & "'"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$dateClause</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$i + 1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[If ( IsEmpty ( $conditions ) ;
	$dateClause & ")" ;
	$conditions & " AND " & $dateClause & ")"
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$conditions</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Text search filter (ANDed on top of status/date)</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $filter )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Lower ( Substitute ( $filter ; "'" ; "''" ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$fEsc</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["(LOWER(so.ServiceOrderNumber) LIKE '%" & $fEsc & "%'" &
" OR LOWER(so.Description) LIKE '%" & $fEsc & "%'" &
" OR LOWER(vh.PlateNumber) LIKE '%" & $fEsc & "%'" &
" OR LOWER(cl.FirstName) LIKE '%" & $fEsc & "%'" &
" OR LOWER(cl.LastName) LIKE '%" & $fEsc & "%'" &
" OR LOWER(cl.CompanyName) LIKE '%" & $fEsc & "%')"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$textClause</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[If ( IsEmpty ( $conditions ) ; $textClause ; $conditions & " AND " & $textClause )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$conditions</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Assemble full SQL — LEFT JOINs to Clients, Vehicles, Staff</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Char ( 34 )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$dq</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["SELECT so.PrimaryKey, so.ServiceOrderNumber, so.JobDate, so.Status, so.Description," &
" cl.FirstName, cl.LastName, cl.CompanyName," &
" vh.Manufacturer, vh.Model, vh.PlateNumber" &
" FROM ServiceOrders AS so" &
" LEFT JOIN Clients AS cl ON so.ForeignKeyClient = cl.PrimaryKey" &
" LEFT JOIN Vehicles AS vh ON so.ForeignKeyVehicle = vh.PrimaryKey" &
If ( not IsEmpty ( $conditions ) ; " WHERE " & $conditions ; "" ) &
" ORDER BY so.JobDate DESC" &
" OFFSET " & $offset & " ROWS FETCH FIRST " & $limit & " ROWS ONLY"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$sql</Name>
  </Step>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Execute SQL</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ExecuteSQL ( $sql ; "|" ; "¶" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$rawResult</Name>
  </Step>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: SQL error or empty result — push empty payload to web viewer</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $rawResult ) or $rawResult = "?"]]></Calculation>
  </Step>
  <Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
    <ObjectName>
      <Calculation><![CDATA["wv_SOPicker"]]></Calculation>
    </ObjectName>
    <FunctionName>
      <Calculation><![CDATA["injectSOs"]]></Calculation>
    </FunctionName>
    <Parameters Count="1">
      <P>
        <Calculation><![CDATA[JSONSetElement ( "{}" ;
	["results" ; "[]" ; JSONArray] ;
	["requestGen" ; $requestGen ; JSONString] ;
	["hasMore" ; False ; JSONBoolean]
)]]></Calculation>
      </P>
    </Parameters>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[""]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Convert SQL result to JSON array</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( "[]" ;
	[0  ; "pk"              ; JSONString] ;
	[1  ; "number"          ; JSONString] ;
	[2  ; "date"            ; JSONString] ;
	[3  ; "status"          ; JSONString] ;
	[4  ; "description"     ; JSONString] ;
	[5  ; "clientFirstName" ; JSONString] ;
	[6  ; "clientLastName"  ; JSONString] ;
	[7  ; "clientCompany"   ; JSONString] ;
	[8  ; "vehicleMake"     ; JSONString] ;
	[9  ; "vehicleModel"    ; JSONString] ;
	[10 ; "plate"           ; JSONString]
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$fields</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( "[]" ;
	[0  ; "text" ; JSONString] ;
	[1  ; "text" ; JSONString] ;
	[2  ; "text" ; JSONString] ;
	[3  ; "text" ; JSONString] ;
	[4  ; "text" ; JSONString] ;
	[5  ; "text" ; JSONString] ;
	[6  ; "text" ; JSONString] ;
	[7  ; "text" ; JSONString] ;
	[8  ; "text" ; JSONString] ;
	[9  ; "text" ; JSONString] ;
	[10 ; "text" ; JSONString]
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$types</Name>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ;
	["sqlResult" ; $rawResult ; JSONString] ;
	["fields"    ; $fields    ; JSONArray]  ;
	["types"     ; $types     ; JSONArray]
)]]></Calculation>
    <Script id="570" name="ConvertSQLResultToJSON"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( ScriptResult )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$results</Name>
  </Step>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Fetch staff per SO via link table and merge into results</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ValueCount ( JSONListKeys ( $results ; "" ) )]]></Calculation>
    </Value>
    <Name>$resultCount</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[$resultCount > 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[""]]></Calculation>
    </Value>
    <Name>$pkList</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$i >= $resultCount]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $results ; "[" & $i & "].pk" )]]></Calculation>
    </Value>
    <Name>$pk</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$pkList & If ( IsEmpty ( $pkList ) ; "" ; ", " ) & "'" & Substitute ( $pk ; "'" ; "''" ) & "'"]]></Calculation>
    </Value>
    <Name>$pkList</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$i + 1]]></Calculation>
    </Value>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["SELECT sos.ForeignKeyServiceOrder, st.FirstName, st.LastName" &
" FROM ServiceOrderStaff AS sos" &
" JOIN Staff AS st ON sos.ForeignKeyStaff = st.PrimaryKey" &
" WHERE sos.ForeignKeyServiceOrder IN (" & $pkList & ")" &
" ORDER BY sos.ForeignKeyServiceOrder, sos.AssignedAt"]]></Calculation>
    </Value>
    <Name>$staffSql</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ExecuteSQL ( $staffSql ; "|" ; "¶" )]]></Calculation>
    </Value>
    <Name>$staffRaw</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["{}"]]></Calculation>
    </Value>
    <Name>$staffMap</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[not IsEmpty ( $staffRaw ) and $staffRaw <> "?"]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ValueCount ( $staffRaw )]]></Calculation>
    </Value>
    <Name>$staffRowCount</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[1]]></Calculation>
    </Value>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$i > $staffRowCount]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Substitute ( GetValue ( $staffRaw ; $i ) ; "|" ; ¶ )]]></Calculation>
    </Value>
    <Name>$row</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetValue ( $row ; 1 )]]></Calculation>
    </Value>
    <Name>$soPK</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetValue ( $row ; 2 )]]></Calculation>
    </Value>
    <Name>$first</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetValue ( $row ; 3 )]]></Calculation>
    </Value>
    <Name>$last</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $staffMap ; $soPK & ".first" )]]></Calculation>
    </Value>
    <Name>$prevFirst</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $staffMap ; $soPK & ".last" )]]></Calculation>
    </Value>
    <Name>$prevLast</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $staffMap ;
	[ $soPK & ".first" ; If ( IsEmpty ( $prevFirst ) ; $first ; $prevFirst & ", " & $first ) ; JSONString ] ;
	[ $soPK & ".last"  ; If ( IsEmpty ( $prevLast )  ; $last  ; $prevLast  & ", " & $last  ) ; JSONString ]
)]]></Calculation>
    </Value>
    <Name>$staffMap</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$i + 1]]></Calculation>
    </Value>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>Inject mechanicFirst / mechanicLast into each result row</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$i >= $resultCount]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $results ; "[" & $i & "].pk" )]]></Calculation>
    </Value>
    <Name>$pk</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( $results ;
	[ "[" & $i & "].mechanicFirst" ; JSONGetElement ( $staffMap ; $pk & ".first" ) ; JSONString ] ;
	[ "[" & $i & "].mechanicLast"  ; JSONGetElement ( $staffMap ; $pk & ".last" )  ; JSONString ]
)]]></Calculation>
    </Value>
    <Name>$results</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$i + 1]]></Calculation>
    </Value>
    <Name>$i</Name>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Build response envelope and push to web viewer</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( "{}" ;
	["results"    ; $results    ; JSONArray]  ;
	["requestGen" ; $requestGen ; JSONString] ;
	["hasMore"    ; ValueCount ( $rawResult ) >= $limit ; JSONBoolean] ;
	["offset"     ; $offset     ; JSONNumber]
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$response</Name>
  </Step>
