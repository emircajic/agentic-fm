<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Build the reprint-fiscal payload for one invoice from invoiceId via epSQL. Context-agnostic, headless. PHASE B CHANGE: epSQL FROM-clause moved off the legacy TO — "Invoices" → "I__INVOICES". No other change.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS (JSON): invoiceId (required).&#xD;RETURNS: data.payload {brojFiskalnogRacuna, companyType}.</Text>
		<Field>$README</Field>
	</Step>
	<Step enable="True" id="89" name="# (comment)"/>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "invoiceId" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $invoiceId )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "invoiceId is required" ; "invoiceId" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$sql</Name>
		<Value><Calculation><![CDATA["SELECT i.\"BrojFiskalnogRacuna\", c.\"CompanyType\" " &
"FROM \"I__INVOICES\" i " &
"LEFT JOIN \"Company\" c ON c.\"PrimaryKey\" = i.\"ForeignKeyCompanyID\" " &
"WHERE i.\"PrimaryKey\" = ?"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute ( $sql ; "useSQLResult=rs_rp" ; $invoiceId )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err ) or epSQLResultRowCount ( "rs_rp" ) = 0]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "NOT_FOUND" ; "Invoice not found or SQL error: " & $invoiceId & " " & $err ; "invoiceId" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "rs_rp" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$brojFiskalnog</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 0 ; "rs_rp" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$companyType</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 1 ; "rs_rp" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "rs_rp" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $brojFiskalnog )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "NOT_FISCALIZED" ; "Nema fiskalnog broja" ; "brojFiskalnogRacuna" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ; "payload" ;
	JSONSetElement ( "{}" ;
		[ "brojFiskalnogRacuna" ; $brojFiskalnog ; JSONString ] ;
		[ "companyType" ; $companyType ; JSONString ]
	) ; JSONObject ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
