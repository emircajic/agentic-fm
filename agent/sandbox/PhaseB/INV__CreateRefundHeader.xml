<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Headless worker — create the Reklamacija header record for an original invoice via epSQL INSERT. Replaces the Dev-layout / current-record body of INV__CreateRefundHeader (730): all inputs come from params, PK is generated explicitly with TSID (auto-enter is "do not replace"), no layout hop, no New Record.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS (JSON): originalInvoiceID (required — PrimaryKey of the source Račun)&#xD;  datum (optional — refund date; defaults to today)&#xD;&#xD;RETURNS: data.refundInvoiceID — PrimaryKey of the new Reklamacija&#xD;&#xD;Client, company and payment type are copied from the original invoice by SQL — the caller no longer needs record context.&#xD;Headless litmus: PSoS/OData-safe. Unblocks deleting the Dev Invoices layout (179).</Text>
		<Field>$README</Field>
	</Step>
	<Step enable="True" id="89" name="# (comment)"/>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "originalInvoiceID|datum" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SCRIPT_START" ; "INV__CreateRefundHeader" ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $originalInvoiceID )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "originalInvoiceID is required" ; "originalInvoiceID" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: ReadOriginal</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT \"ForeignKeyClientID\", \"ForeignKeyCompanyID\", \"NacinPlacanja\" FROM \"I__INVOICES\" WHERE \"PrimaryKey\" = ?" ;
	"useSQLResult=rs_orig" ;
	$originalInvoiceID
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "SQL_FAIL" ; $err ; "originalInvoiceID" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[epSQLResultRowCount ( "rs_orig" ) = 0]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "NOT_FOUND" ; "Original invoice not found: " & $originalInvoiceID ; "originalInvoiceID" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "rs_orig" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$clientId</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 0 ; "rs_orig" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$companyId</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 1 ; "rs_orig" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$paymentType</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 2 ; "rs_orig" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "rs_orig" )]]></Calculation></Value>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Insert</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$newId</Name>
		<Value><Calculation><![CDATA[TSID]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$datumValue</Name>
		<Value><Calculation><![CDATA[If ( IsEmpty ( $datum ) ; Get ( CurrentDate ) ; GetAsDate ( $datum ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"INSERT INTO \"I__INVOICES\" ( \"PrimaryKey\", \"StatusDokumenta\", \"ForeignKeyOriginalInvoiceID\", \"Datum\", \"ForeignKeyClientID\", \"ForeignKeyCompanyID\", \"NacinPlacanja\" ) VALUES ( ?, ?, ?, ?, ?, ?, ? )" ;
	"" ;
	$newId ;
	"Reklamacija" ;
	$originalInvoiceID ;
	$datumValue ;
	$clientId ;
	$companyId ;
	$paymentType
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "INSERT_FAIL" ; $err ; "I__INVOICES" ; JSONSetElement ( "{}" ; "originalInvoiceID" ; $originalInvoiceID ; JSONString ) ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ; "refundInvoiceID" ; $newId ; JSONString ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
	<Step enable="True" id="25" name="Perform Script">
		<Script id="780" name="UTIL__FlushLog"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
