<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Headless effectful worker — create one invoice (header + InvoiceLinks row + lines) for a service order via epSQL INSERTs, then recalc the invoice value. Replaces the Dev-layout body of SO__CreateSingleInvoice (630): no Go to Layout, no New Record, no GTRR. Writes target the I__ TOG so the legacy TOs can drop.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS (JSON) — same contract as the old 630:&#xD;  orderID (required) | customerID | companyID (required) | companyType | vehicleDetails | orderNumber | linesJSON (required, non-empty array of {description, qty, rate, jm, type, stavkaPrimkeID})&#xD;&#xD;RETURNS: data.invoiceId, data.lineCount&#xD;&#xD;CHANGES vs 630: PKs generated with TSID (auto-enter is "do not replace"); "Kalkuliši vrijednost fakture" replaced by INV__CalcInvoiceValue worker; the final GTRR to the Invoices layout is dropped — navigation belongs to the caller (e.g. Navigation_ ( "invoices|" &amp; invoiceId )).&#xD;Headless litmus: PSoS/OData-safe. Removes a Dev Invoices / Dev-layout dependency.</Text>
		<Field>$README</Field>
	</Step>
	<Step enable="True" id="89" name="# (comment)"/>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "orderID|orderNumber|vehicleDetails|customerID|companyID|companyType|linesJSON" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SCRIPT_START" ; "SO__CreateSingleInvoice" ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$lineCount</Name>
		<Value><Calculation><![CDATA[ValueCount ( JSONListKeys ( $linesJSON ; "" ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $orderID ) or IsEmpty ( $companyID ) or $lineCount = 0]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "orderID, companyID and a non-empty linesJSON are required" ; "" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Header</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$invoiceId</Name>
		<Value><Calculation><![CDATA[TSID]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"INSERT INTO \"I__INVOICES\" ( \"PrimaryKey\", \"ForeignKeyClientID\", \"ForeignKeyCompanyID\", \"Napomene\", \"Datum\" ) VALUES ( ?, ?, ?, ?, ? )" ;
	"" ;
	$invoiceId ;
	$customerID ;
	$companyID ;
	$vehicleDetails ;
	Get ( CurrentDate )
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "INSERT_FAIL" ; $err ; "I__INVOICES" ; JSONSetElement ( "{}" ; "orderID" ; $orderID ; JSONString ) ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: InvoiceLink</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"INSERT INTO \"I__InvoiceLinks\" ( \"PrimaryKey\", \"ForeignKeyInvoiceID\", \"ForeignKeyServiceOrderID\" ) VALUES ( ?, ?, ? )" ;
	"" ;
	TSID ;
	$invoiceId ;
	$orderID
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "INSERT_FAIL" ; $err ; "I__InvoiceLinks" ; JSONSetElement ( "{}" ; "invoiceId" ; $invoiceId ; JSONString ) ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Lines</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$created</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="71" name="Loop">
		<FlushType value="Always"/>
	</Step>
	<Step enable="True" id="72" name="Exit Loop If">
		<Calculation><![CDATA[$i ≥ $lineCount]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$currentLine</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $linesJSON ; "[" & $i & "]" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"INSERT INTO \"I__InvoiceLines\" ( \"PrimaryKey\", \"ForeignKeyInvoiceID\", \"Description\", \"Qty\", \"Rate\", \"JM\", \"VrstaStavke\", \"ForeignKeyStavkaUlazneFakture\" ) VALUES ( ?, ?, ?, ?, ?, ?, ?, ? )" ;
	"" ;
	TSID ;
	$invoiceId ;
	JSONGetElement ( $currentLine ; "description" ) ;
	GetAsNumber ( JSONGetElement ( $currentLine ; "qty" ) ) ;
	GetAsNumber ( JSONGetElement ( $currentLine ; "rate" ) ) ;
	JSONGetElement ( $currentLine ; "jm" ) ;
	JSONGetElement ( $currentLine ; "type" ) ;
	JSONGetElement ( $currentLine ; "stavkaPrimkeID" )
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$created</Name>
		<Value><Calculation><![CDATA[$created + 1]]></Calculation></Value>
	</Step>
	<Step enable="True" id="69" name="Else"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddWarning ( "LINE_INSERT_FAIL" ; $err ; "I__InvoiceLines" ; JSONSetElement ( "{}" ; "row" ; $i ; JSONNumber ) ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[$i + 1]]></Calculation></Value>
	</Step>
	<Step enable="True" id="73" name="End Loop"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: RecalcValue — replaces GTRR + "Kalkuliši vrijednost fakture"</Text>
	</Step>
	<Step enable="True" id="25" name="Perform Script">
		<Script id="0" name="INV__CalcInvoiceValue"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "invoiceId" ; $invoiceId ; JSONString ] ;
	[ "traceID" ; $traceID ; JSONString ]
)]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Absorb ( Get ( ScriptResult ) )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ;
	[ "invoiceId" ; $invoiceId ; JSONString ] ;
	[ "lineCount" ; $created ; JSONNumber ]
) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
	<Step enable="True" id="25" name="Perform Script">
		<Script id="780" name="UTIL__FlushLog"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
