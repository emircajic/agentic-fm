<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Headless worker — create a new invoice header for the active company via epSQL INSERT. Replaces the record-bound body of INV__DodajRačun (643), which did New Record/Request on the layout and read Company::CompanyType from the current record.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS (JSON): companyType (optional — "OD" | "DOO"; defaults to Settings invoices.currentCompany)&#xD;&#xD;RETURNS: data.invoiceId — PrimaryKey of the new invoice&#xD;&#xD;StatusDokumenta and NacinPlacanja are auto-enter (ConstantData) and fill on INSERT.&#xD;UI navigation to the new record stays with the caller — e.g. Navigation_ ( "invoices|" &amp; invoiceId ) then dispatcher action=load.</Text>
		<Field>$README</Field>
	</Step>
	<Step enable="True" id="89" name="# (comment)"/>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "companyType" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SCRIPT_START" ; "INV__DodajRačun" ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$companyType</Name>
		<Value><Calculation><![CDATA[If ( IsEmpty ( $companyType ) ; Settings_Get ( "invoices.currentCompany" ; "OD" ) ; $companyType )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$companyId</Name>
		<Value><Calculation><![CDATA[getCompanyID ( $companyType )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $companyId )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "UNKNOWN_COMPANY" ; "No company found for type: " & $companyType ; "companyType" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Insert</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$newId</Name>
		<Value><Calculation><![CDATA[TSID]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"INSERT INTO \"I__INVOICES\" ( \"PrimaryKey\", \"ForeignKeyCompanyID\" ) VALUES ( ?, ? )" ;
	"" ;
	$newId ;
	$companyId
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "INSERT_FAIL" ; $err ; "I__INVOICES" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ; "invoiceId" ; $newId ; JSONString ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
	<Step enable="True" id="25" name="Perform Script">
		<Script id="780" name="UTIL__FlushLog"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
