<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Headless worker — build the "last N invoices" list for one document type + company via epSQL. Replaces the body of INV__RecalculateLastInvoicesList (649): no current-record reads, no Globals writes. The dispatcher owns the Globals::LastInvoiceList write and the object refresh.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS (JSON): tip (required — "Račun" | "Predračun" | "Reklamacija")&#xD;  companyId (required — Company PrimaryKey)&#xD;  limit (optional, default 10)&#xD;&#xD;RETURNS: data.list — CR-delimited rows, TAB-separated columns: BrojFakture ⇥ dd.mm.yyyy&#xD;  data.count — row count&#xD;&#xD;Headless litmus: no layout, record, or found-set dependence. PSoS/OData-safe.</Text>
		<Field>$README</Field>
	</Step>
	<Step enable="True" id="89" name="# (comment)"/>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "tip|companyId|limit" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SCRIPT_START" ; "INV__LoadLastInvoices" ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $tip ) or IsEmpty ( $companyId )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "tip and companyId are required" ; "" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$limit</Name>
		<Value><Calculation><![CDATA[Let (
	~n = Int ( GetAsNumber ( $limit ) ) ;
	If ( ~n < 1 ; 10 ; ~n )
)]]></Calculation></Value>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Query</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$sql</Name>
		<Value><Calculation><![CDATA["SELECT \"BrojFakture\", RIGHT ( STRVAL ( \"Datum\" ) , 2 ) + '.' + SUBSTR ( STRVAL ( \"Datum\" ) , 6 , 2 ) + '.' + LEFT ( STRVAL ( \"Datum\" ) , 4 ) " &
"FROM \"I__INVOICES\" " &
"WHERE \"StatusDokumenta\" = ? AND \"ForeignKeyCompanyID\" = ? " &
"ORDER BY \"Datum\" DESC, \"BrojFakture\" DESC " &
"FETCH FIRST " & $limit & " ROWS ONLY"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute ( $sql ; "useSQLResult=rs_last" ; $tip ; $companyId )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "SQL_FAIL" ; $err ; "list" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: BuildList</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$rowCount</Name>
		<Value><Calculation><![CDATA[epSQLResultRowCount ( "rs_last" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$list</Name>
		<Value><Calculation><![CDATA[""]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="71" name="Loop">
		<FlushType value="Always"/>
	</Step>
	<Step enable="True" id="72" name="Exit Loop If">
		<Calculation><![CDATA[$i ≥ $rowCount]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$list</Name>
		<Value><Calculation><![CDATA[$list & If ( $i > 0 ; ¶ ; "" ) & epSQLResult ( $i ; 0 ; "rs_last" ) & Char ( 9 ) & epSQLResult ( $i ; 1 ; "rs_last" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[$i + 1]]></Calculation></Value>
	</Step>
	<Step enable="True" id="73" name="End Loop"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "rs_last" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ;
	[ "list" ; $list ; JSONString ] ;
	[ "count" ; $rowCount ; JSONNumber ]
) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
	<Step enable="True" id="25" name="Perform Script">
		<Script id="780" name="UTIL__FlushLog"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>Example call from the dispatcher</Text>
	</Step>
	<Step enable="False" id="25" name="Perform Script">
		<Script id="0" name="INV__LoadLastInvoices"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "tip" ; "Račun" ; JSONString ] ;
	[ "companyId" ; getCompanyID ( Settings_Get ( "invoices.currentCompany" ; "OD" ) ) ; JSONString ] ;
	[ "traceID" ; $traceID ; JSONString ]
)]]></Calculation>
	</Step>

</fmxmlsnippet>
