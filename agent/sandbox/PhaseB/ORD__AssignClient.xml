<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Headless worker — assign a client to a target record via epSQL UPDATE. Re-homed from "Postavi klijenta" (489) per the Phase B worklist. Supports both targets because the client picker is shared: "invoice" writes I__INVOICES.ForeignKeyClientID, "order" writes ServiceOrders.ForeignKeyClient.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS (JSON): clientId (required — Clients PrimaryKey)&#xD;  targetId (required — PrimaryKey of the invoice or service order)&#xD;  target (optional — "invoice" | "order"; default "invoice")&#xD;&#xD;RETURNS: data { target, targetId, clientId }&#xD;&#xD;NOTE: the sanitized 489 body wrote Invoices::ForeignKeyClientID; the worklist note says "writes order, not invoice". Audit the live 489 body — if it writes the order, flip the caller's target param, no code change needed.&#xD;UI concerns from the old script (Close Window) move to the caller/dispatcher.</Text>
		<Field>$README</Field>
	</Step>
	<Step enable="True" id="89" name="# (comment)"/>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "clientId|targetId|target" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SCRIPT_START" ; "ORD__AssignClient" ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $clientId ) or IsEmpty ( $targetId )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "clientId and targetId are required" ; "" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$target</Name>
		<Value><Calculation><![CDATA[If ( IsEmpty ( $target ) ; "invoice" ; $target )]]></Calculation></Value>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Update</Text>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$target = "order"]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"UPDATE \"ServiceOrders\" SET \"ForeignKeyClient\" = ? WHERE \"PrimaryKey\" = ?" ;
	"" ;
	$clientId ;
	$targetId
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="125" name="Else If">
		<Calculation><![CDATA[$target = "invoice"]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"UPDATE \"I__INVOICES\" SET \"ForeignKeyClientID\" = ? WHERE \"PrimaryKey\" = ?" ;
	"" ;
	$clientId ;
	$targetId
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="69" name="Else"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "UNKNOWN_TARGET" ; "target must be \"invoice\" or \"order\": " & $target ; "target" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "UPDATE_FAIL" ; $err ; $target ; JSONSetElement ( "{}" ; "targetId" ; $targetId ; JSONString ) ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ;
	[ "target" ; $target ; JSONString ] ;
	[ "targetId" ; $targetId ; JSONString ] ;
	[ "clientId" ; $clientId ; JSONString ]
) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
	<Step enable="True" id="25" name="Perform Script">
		<Script id="780" name="UTIL__FlushLog"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
