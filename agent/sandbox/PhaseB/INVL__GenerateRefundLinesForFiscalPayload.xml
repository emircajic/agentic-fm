<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Headless worker — copy all lines of the original invoice onto the refund (Reklamacija) invoice via epSQL SELECT + INSERT, including ForeignKeyStavkaUlazneFakture (batch link). Replaces the layout-hop / found-set body of INVL__GenerateRefundLinesForFiscalPayload (731).</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS (JSON): originalInvoiceID (required — PrimaryKey of the source Račun)&#xD;  refundInvoiceID (required — PrimaryKey of the Reklamacija to populate)&#xD;&#xD;RETURNS: data.count — number of lines created. Row-level INSERT failures become warnings, not hard errors.&#xD;&#xD;Headless litmus: no layout, record, or found-set dependence. PSoS/OData-safe. Unblocks deleting Dev Invoices / Dev InvoiceLines layouts.</Text>
		<Field>$README</Field>
	</Step>
	<Step enable="True" id="89" name="# (comment)"/>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "originalInvoiceID|refundInvoiceID" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SCRIPT_START" ; "INVL__GenerateRefundLinesForFiscalPayload" ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $originalInvoiceID ) or IsEmpty ( $refundInvoiceID )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "originalInvoiceID and refundInvoiceID are required" ; "" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: ReadOriginalLines</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT \"Sifra\", \"Description\", \"JM\", \"Rate\", \"Qty\", \"Discount\", \"VrstaStavke\", \"ForeignKeyArtikal\", \"ForeignKeyStavkaUlazneFakture\" " &
	"FROM \"I__InvoiceLines\" WHERE \"ForeignKeyInvoiceID\" = ? ORDER BY \"PrimaryKey\"" ;
	"useSQLResult=rs_src" ;
	$originalInvoiceID
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "SQL_FAIL" ; $err ; "lines" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$total</Name>
		<Value><Calculation><![CDATA[epSQLResultRowCount ( "rs_src" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$total = 0]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "NO_LINES" ; "Original invoice has no lines: " & $originalInvoiceID ; "originalInvoiceID" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "rs_src" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: InsertRefundLines</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$count</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="71" name="Loop">
		<FlushType value="Always"/>
	</Step>
	<Step enable="True" id="72" name="Exit Loop If">
		<Calculation><![CDATA[$i ≥ $total]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"INSERT INTO \"I__InvoiceLines\" ( \"PrimaryKey\", \"ForeignKeyInvoiceID\", \"Sifra\", \"Description\", \"JM\", \"Rate\", \"Qty\", \"Discount\", \"VrstaStavke\", \"ForeignKeyArtikal\", \"ForeignKeyStavkaUlazneFakture\" ) VALUES ( ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ? )" ;
	"" ;
	TSID ;
	$refundInvoiceID ;
	epSQLResult ( $i ; 0 ; "rs_src" ) ;
	epSQLResult ( $i ; 1 ; "rs_src" ) ;
	epSQLResult ( $i ; 2 ; "rs_src" ) ;
	GetAsNumber ( epSQLResult ( $i ; 3 ; "rs_src" ) ) ;
	GetAsNumber ( epSQLResult ( $i ; 4 ; "rs_src" ) ) ;
	GetAsNumber ( epSQLResult ( $i ; 5 ; "rs_src" ) ) ;
	epSQLResult ( $i ; 6 ; "rs_src" ) ;
	epSQLResult ( $i ; 7 ; "rs_src" ) ;
	epSQLResult ( $i ; 8 ; "rs_src" )
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$count</Name>
		<Value><Calculation><![CDATA[$count + 1]]></Calculation></Value>
	</Step>
	<Step enable="True" id="69" name="Else"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddWarning ( "LINE_INSERT_FAIL" ; $err ; "I__InvoiceLines" ; JSONSetElement ( "{}" ; "row" ; $i ; JSONNumber ) ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[$i + 1]]></Calculation></Value>
	</Step>
	<Step enable="True" id="73" name="End Loop"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "rs_src" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ; "count" ; $count ; JSONNumber ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
	<Step enable="True" id="25" name="Perform Script">
		<Script id="780" name="UTIL__FlushLog"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
