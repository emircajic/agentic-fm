<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Headless worker — validate that an invoice may be refunded (Reklamacija). Replaces the record-bound body of INV__ValidateRefundEligibility (729) with an epSQL lookup keyed by invoiceId.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS (JSON): invoiceId (required — Invoices PrimaryKey)&#xD;&#xD;RETURNS: data.eligible = true on success; Response errors otherwise:&#xD;  MISSING_PARAM / SQL_FAIL / NOT_FOUND / NOT_RACUN / NOT_FISCALIZED&#xD;&#xD;Headless litmus: no layout, record, or found-set dependence. PSoS/OData-safe.</Text>
		<Field>$README</Field>
	</Step>
	<Step enable="True" id="89" name="# (comment)"/>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "invoiceId" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SCRIPT_START" ; "INV__ValidateRefundEligibility" ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $invoiceId )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "invoiceId is required" ; "invoiceId" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Lookup</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT \"StatusDokumenta\", \"BrojFiskalnogRacuna\" FROM \"I__INVOICES\" WHERE \"PrimaryKey\" = ?" ;
	"useSQLResult=rs_val" ;
	$invoiceId
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "SQL_FAIL" ; $err ; "invoiceId" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[epSQLResultRowCount ( "rs_val" ) = 0]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "NOT_FOUND" ; "Invoice not found: " & $invoiceId ; "invoiceId" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "rs_val" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$statusDokumenta</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 0 ; "rs_val" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$brojFiskalnog</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 1 ; "rs_val" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "rs_val" )]]></Calculation></Value>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Rules</Text>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$statusDokumenta ≠ "Račun"]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "NOT_RACUN" ; "Samo Račun može biti reklamiran. StatusDokumenta: " & $statusDokumenta ; "StatusDokumenta" ; JSONSetElement ( "{}" ; "invoiceId" ; $invoiceId ; JSONString ) ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $brojFiskalnog )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "NOT_FISCALIZED" ; "Originalni račun nije fiskaliziran." ; "BrojFiskalnogRacuna" ; JSONSetElement ( "{}" ; "invoiceId" ; $invoiceId ; JSONString ) ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ; "eligible" ; True ; JSONBoolean ) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
	<Step enable="True" id="25" name="Perform Script">
		<Script id="780" name="UTIL__FlushLog"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
