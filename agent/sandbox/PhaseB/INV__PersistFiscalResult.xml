<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Persist a fiscal API result onto an invoice via epSQL (headless, no layout hop). The PDF container (PDFFile) is written headless via epSQL with the binary as a ? bind param. Replaces the record-bound Handle Success / Handle Partial scripts. PHASE B CHANGE: epSQL statements moved off the legacy TO — "Invoices" → "I__INVOICES". No other change.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS (JSON): invoiceId (required) | response (required — the fiscal API JSON).&#xD;RETURNS: data {invoiceId, brojFiskalnogRacuna}.&#xD;&#xD;NOTE: binary bind params cannot be epSQLQuote'd — the PDF is passed as ?.&#xD;Stock movements intentionally NOT triggered — the old INV__PostStockMovements was part of the abandoned KR__ approach.</Text>
		<Field>$README</Field>
	</Step>
	<Step enable="True" id="89" name="# (comment)"/>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "invoiceId|response" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $invoiceId ) or IsEmpty ( $response )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "invoiceId and response are required" ; "" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$brojFiskalnog</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "brojFiskalnogRacuna" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$brojReklamiranog</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "brojReklamiranogRacuna" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$type</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "type" )]]></Calculation></Value>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Store the fiscal response (minus pdfBase64) and any numbers</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$responseToStore</Name>
		<Value><Calculation><![CDATA[If ( not IsEmpty ( JSONGetElement ( $response ; "pdfBase64" ) ) ; JSONDeleteElement ( $response ; "pdfBase64" ) ; $response )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"UPDATE \"I__INVOICES\" SET \"FiskalniOdgovor\" = " & epSQLQuote ( $responseToStore ) &
	" WHERE \"PrimaryKey\" = " & epSQLQuote ( $invoiceId ) ; "" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddError ( "SQL_FAIL" ; $err ; "FiskalniOdgovor" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $brojFiskalnog )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"UPDATE \"I__INVOICES\" SET \"BrojFiskalnogRacuna\" = " & epSQLQuote ( $brojFiskalnog ) &
	" WHERE \"PrimaryKey\" = " & epSQLQuote ( $invoiceId ) ; "" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $brojReklamiranog )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"UPDATE \"I__INVOICES\" SET \"BrojReklamiranogRacuna\" = " & epSQLQuote ( $brojReklamiranog ) &
	" WHERE \"PrimaryKey\" = " & epSQLQuote ( $invoiceId ) ; "" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Store the PDF container via epSQL (binary as ? bind param — no layout hop)</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$pdf</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $response ; "pdfBase64" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $pdf )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$pdfContainer</Name>
		<Value><Calculation><![CDATA[Base64Decode ( $pdf ; If ( not IsEmpty ( $brojFiskalnog ) ; $brojFiskalnog ; $invoiceId ) & ".pdf" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"UPDATE \"I__INVOICES\" SET \"PDFFile\" = ? WHERE \"PrimaryKey\" = " & epSQLQuote ( $invoiceId ) ;
	"" ; $pdfContainer )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $err )]]></Calculation>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_AddWarning ( "PDF_STORE_FAILED" ; $err ; "PDFFile" ; "{}" ; "" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>Stock movements intentionally NOT triggered — the old INV__PostStockMovements was part of the abandoned KR__ approach. Out of scope for fiscalization.</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ;
	[ "invoiceId" ; $invoiceId ; JSONString ] ;
	[ "brojFiskalnogRacuna" ; $brojFiskalnog ; JSONString ]
) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
