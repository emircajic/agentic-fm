<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Set ProdajnaCijena on a StavkePrimke and its siblings, then sync all attached ServiceOrderLines::Rate.
Guards: LOCKED (KMP posted — LockedSelling calc = 1), BATCH_INVOICED (InvoiceLine detected for any sibling).
All operations via epSQL — no layout navigation.</Text>
	</Step>

	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS: stavkaPrimkeID (text, required) | newPrice (number, required)
RETURNS: data.updated (number) — stavke updated; data.syncedLines (number) — SOL Rate fields synced

SIBLING SCOPE:
  ForeignKeyUlaznaFakturaID set  →  same artikalID + same UFD
  ForeignKeyUlaznaFakturaID empty  →  same artikalID + same ForeignKeyPrimkaID

LOCK TRIGGERS (abort, no write):
  LOCKED        — LockedSelling = 1 on the target (KMP is Knjižena)
  BATCH_INVOICED — InvoiceLines record found for any sibling (revers scenario)</Text>
		<Field>$README</Field>
	</Step>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "stavkaPrimkeID|newPrice" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SP_SET_PRICE_START" ; "Setting ProdajnaCijena=" & $newPrice & " for stavka " & $stavkaPrimkeID ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Validate ──────────────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $stavkaPrimkeID ) or IsEmpty ( $newPrice )]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "stavkaPrimkeID and newPrice are required" ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Guard: target must exist and not be locked ────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$ctxChk</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT ForeignKeyArtikalID, ForeignKeyUlaznaFakturaID, ForeignKeyPrimkaID
	 FROM StavkePrimke WHERE PrimaryKey = ?" ;
	"useSQLResult=ctxchk" ;
	$stavkaPrimkeID
)]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $ctxChk )]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "SQL_ERROR" ; "SELECT failed: " & $ctxChk ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[epSQLResultRowCount ( "ctxchk" ) = 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[epSQLResultDelete ( "ctxchk" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "NOT_FOUND" ; "StavkePrimke not found: " & $stavkaPrimkeID ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$artikalID</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 0 ; "ctxchk" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$ufdID</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 1 ; "ctxchk" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$primkaID</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 2 ; "ctxchk" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "ctxchk" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$kmpStatusChk</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT KMP__KalkulacijaMP.Status FROM StavkePrimke, KMP__Stavke, KMP__KalkulacijaMP
	 WHERE KMP__Stavke.PrimaryKey = StavkePrimke.PrimaryKey
	   AND KMP__KalkulacijaMP.PrimaryKey = KMP__Stavke.ForeignKeyKalkulacijaID
	   AND StavkePrimke.PrimaryKey = ?" ;
	"useSQLResult=kmpchk" ;
	$stavkaPrimkeID
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$locked</Name>
		<Value><Calculation><![CDATA[GetAsNumber (
	IsEmpty ( $kmpStatusChk )
	and epSQLResultRowCount ( "kmpchk" ) > 0
	and epSQLResult ( 0 ; 0 ; "kmpchk" ) = "Knjižena"
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "kmpchk" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$locked = 1]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "LOCKED" ; "Selling price is locked — KMP is Knjižena" ; "LockedSelling" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Find siblings ─────────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$sibSel</Name>
		<Value><Calculation><![CDATA[If ( not IsEmpty ( $ufdID ) ;
	epSQLExecute (
		"SELECT PrimaryKey FROM StavkePrimke WHERE ForeignKeyArtikalID = ? AND ForeignKeyUlaznaFakturaID = ?" ;
		"useSQLResult=sibchk" ; $artikalID ; $ufdID
	) ;
	epSQLExecute (
		"SELECT PrimaryKey FROM StavkePrimke WHERE ForeignKeyArtikalID = ? AND ForeignKeyPrimkaID = ?" ;
		"useSQLResult=sibchk" ; $artikalID ; $primkaID
	)
)]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $sibSel )]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "SQL_ERROR" ; "Sibling SELECT failed: " & $sibSel ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$sibCount</Name>
		<Value><Calculation><![CDATA[epSQLResultRowCount ( "sibchk" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Guard: BATCH_INVOICED — reject if any sibling has an InvoiceLine ──────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$invoiced</Name>
		<Value><Calculation><![CDATA[False]]></Calculation></Value>
	</Step>

	<Step enable="True" id="71" name="Loop">
		<FlushType value="Always"/>
	</Step>
		<Step enable="True" id="74" name="Exit Loop If">
			<Calculation><![CDATA[$i >= $sibCount or $invoiced]]></Calculation>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$sibPK</Name>
			<Value><Calculation><![CDATA[epSQLResult ( $i ; 0 ; "sibchk" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$invCount</Name>
			<Value><Calculation><![CDATA[GetAsNumber ( ExecuteSQL ( "SELECT COUNT(*) FROM InvoiceLines WHERE ForeignKeyStavkaUlazneFakture = ?" ; "" ; "" ; $sibPK ) )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$invCount > 0]]></Calculation>
		</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$invoiced</Name>
				<Value><Calculation><![CDATA[True]]></Calculation></Value>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$i</Name>
			<Value><Calculation><![CDATA[$i + 1]]></Calculation></Value>
		</Step>
	<Step enable="True" id="73" name="End Loop"/>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$invoiced]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[epSQLResultDelete ( "sibchk" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "BATCH_INVOICED" ; "Batch invoiced — selling price is locked for all siblings" ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Log.add ( "warn" ; "SP_BATCH_INVOICED" ; "artikalID=" & $artikalID ; $params )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Set ProdajnaCijena on all siblings ────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$updatedCount</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>

	<Step enable="True" id="71" name="Loop">
		<FlushType value="Always"/>
	</Step>
		<Step enable="True" id="74" name="Exit Loop If">
			<Calculation><![CDATA[$i >= $sibCount]]></Calculation>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$sibPK</Name>
			<Value><Calculation><![CDATA[epSQLResult ( $i ; 0 ; "sibchk" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$upd</Name>
			<Value><Calculation><![CDATA[epSQLExecute ( "UPDATE StavkePrimke SET ProdajnaCijena = ? WHERE PrimaryKey = ?" ; "" ; $newPrice ; $sibPK )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[IsEmpty ( $upd )]]></Calculation>
		</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$updatedCount</Name>
				<Value><Calculation><![CDATA[$updatedCount + 1]]></Calculation></Value>
			</Step>
		<Step enable="True" id="69" name="Else"/>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$void</Name>
				<Value><Calculation><![CDATA[Response_AddWarning ( "UPDATE_FAILED" ; "Failed to set ProdajnaCijena: " & $upd ; "" ; JSONSetElement ( "{}" ; "stavkaPK" ; $sibPK ; JSONString ) ; "" )]]></Calculation></Value>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$i</Name>
			<Value><Calculation><![CDATA[$i + 1]]></Calculation></Value>
		</Step>
	<Step enable="True" id="73" name="End Loop"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Sync ServiceOrderLines::Rate ──────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$syncedLines</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>

	<Step enable="True" id="71" name="Loop">
		<FlushType value="Always"/>
	</Step>
		<Step enable="True" id="74" name="Exit Loop If">
			<Calculation><![CDATA[$i >= $sibCount]]></Calculation>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$sibPK</Name>
			<Value><Calculation><![CDATA[epSQLResult ( $i ; 0 ; "sibchk" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$solUpd</Name>
			<Value><Calculation><![CDATA[epSQLExecute ( "UPDATE ServiceOrderLines SET Rate = ? WHERE ForeignKeyStavkaPrimkeID = ?" ; "" ; $newPrice ; $sibPK )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[IsEmpty ( $solUpd )]]></Calculation>
		</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$syncedLines</Name>
				<Value><Calculation><![CDATA[$syncedLines + 1]]></Calculation></Value>
			</Step>
		<Step enable="True" id="69" name="Else"/>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$void</Name>
				<Value><Calculation><![CDATA[Response_AddWarning ( "SOL_SYNC_FAILED" ; "Failed to sync Rate: " & $solUpd ; "" ; JSONSetElement ( "{}" ; "stavkaPK" ; $sibPK ; JSONString ) ; "" )]]></Calculation></Value>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$i</Name>
			<Value><Calculation><![CDATA[$i + 1]]></Calculation></Value>
		</Step>
	<Step enable="True" id="73" name="End Loop"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "sibchk" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Success ───────────────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ;
	[ "updated"      ; $updatedCount ; JSONNumber ] ;
	[ "syncedLines"  ; $syncedLines  ; JSONNumber ]
) )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "SP_SET_PRICE_DONE" ; "Updated " & $updatedCount & " stavke, synced " & $syncedLines & " SOL lines" ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
		<Step enable="True" id="25" name="Perform Script">
			<Script id="780" name="UTIL__FlushLog"/>
			<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
