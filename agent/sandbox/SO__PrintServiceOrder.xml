<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Collect all data for the current service order (header + lines) on ServiceOrderDetails, build the print envelope JSON, and POST it to the print server. Runs on the current ServiceOrders record — no layout hops.</Text>
	</Step>

	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>ENDPOINT: http://192.168.0.150:54321/print  (adjust path if the server expects something other than /print)
ENVELOPE: { klijent, vozilo, opisProblema, serviser, pocetakRadova, zavrsetakRadova, napomene, materijal[], usluga[], trosak[] }
LINE CLASSIFICATION (interim, until item types are modelled):
  rate &lt; 0                      -> trosak
  has ForeignKeyStavkaPrimkeID   -> materijal
  otherwise                      -> usluga</Text>
		<Field table="" id="0" name="$README"/>
	</Step>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>

	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="On"/>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Commit so epSQL sees the latest field values ──────────────────────────</Text>
	</Step>

	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoInteract state="True"/>
		<Option state="False"/>
		<ESSForceCommit state="False"/>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$url</Name>
		<Value><Calculation><![CDATA["http://192.168.0.150:54321/print"]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$orderPK</Name>
		<Value><Calculation><![CDATA[ServiceOrders::PrimaryKey]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Header: klijent ───────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$klijent</Name>
		<Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "ime"     ; ServiceOrders::ClientName_Calculation ; JSONString ] ;
	[ "telefon" ; Clients::Phone                        ; JSONString ]
)]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Header: vozilo ────────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$vozilo</Name>
		<Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "marka"        ; Vehicles → Service Orders::Manufacturer                  ; JSONString ] ;
	[ "model"        ; Vehicles → Service Orders::Model                         ; JSONString ] ;
	[ "godiste"      ; GetAsText ( Vehicles → Service Orders::YearManufactured ) ; JSONString ] ;
	[ "vin"          ; Vehicles → Service Orders::VIN                           ; JSONString ] ;
	[ "registracija" ; Vehicles → Service Orders::PlateNumber                   ; JSONString ] ;
	[ "kilometraza"  ; GetAsText ( ServiceOrders::Odometer )                    ; JSONString ]
)]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Lines: SELECT once, classify in a loop ────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$selLines</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT \"Description\", \"Qty\", \"Rate\", \"ForeignKeyStavkaPrimkeID\"
	 FROM \"ServiceOrderLines\"
	 WHERE \"ForeignKeyServiceOrder\" = ?
	 ORDER BY \"CreationTimestamp\"" ;
	"useSQLResult=sol" ;
	$orderPK
)]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $selLines )]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[epSQLResultDelete ( "sol" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="87" name="Show Custom Dialog">
			<Title><Calculation><![CDATA["Greška"]]></Calculation></Title>
			<Message><Calculation><![CDATA["Ne mogu učitati stavke naloga." & ¶ & ¶ & $selLines]]></Calculation></Message>
			<Buttons>
				<Button CommitState="True"><Calculation><![CDATA["OK"]]></Calculation></Button>
			</Buttons>
		</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[""]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$rowCount</Name>
		<Value><Calculation><![CDATA[epSQLResultRowCount ( "sol" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$materijal</Name>
		<Value><Calculation><![CDATA["[]"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$usluga</Name>
		<Value><Calculation><![CDATA["[]"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$trosak</Name>
		<Value><Calculation><![CDATA["[]"]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$mIdx</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$uIdx</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$tIdx</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$i</Name>
		<Value><Calculation><![CDATA[0]]></Calculation></Value>
	</Step>

	<Step enable="True" id="71" name="Loop">
		<FlushType value="Always"/>
	</Step>
		<Step enable="True" id="72" name="Exit Loop If">
			<Calculation><![CDATA[$i ≥ $rowCount]]></Calculation>
		</Step>

		<Step enable="True" id="141" name="Set Variable">
			<Name>$rate</Name>
			<Value><Calculation><![CDATA[GetAsNumber ( epSQLResult ( $i ; 2 ; "sol" ) )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$stavkaID</Name>
			<Value><Calculation><![CDATA[epSQLResult ( $i ; 3 ; "sol" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$item</Name>
			<Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "naziv"    ; epSQLResult ( $i ; 0 ; "sol" )                ; JSONString ] ;
	[ "kolicina" ; GetAsNumber ( epSQLResult ( $i ; 1 ; "sol" ) ) ; JSONNumber ] ;
	[ "iznos"    ; $rate                                          ; JSONNumber ]
)]]></Calculation></Value>
		</Step>

		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$rate < 0]]></Calculation>
		</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$trosak</Name>
				<Value><Calculation><![CDATA[JSONSetElement ( $trosak ; "[" & $tIdx & "]" ; $item ; JSONObject )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$tIdx</Name>
				<Value><Calculation><![CDATA[$tIdx + 1]]></Calculation></Value>
			</Step>
		<Step enable="True" id="125" name="Else If">
			<Calculation><![CDATA[not IsEmpty ( $stavkaID )]]></Calculation>
		</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$materijal</Name>
				<Value><Calculation><![CDATA[JSONSetElement ( $materijal ; "[" & $mIdx & "]" ; $item ; JSONObject )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$mIdx</Name>
				<Value><Calculation><![CDATA[$mIdx + 1]]></Calculation></Value>
			</Step>
		<Step enable="True" id="69" name="Else"/>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$usluga</Name>
				<Value><Calculation><![CDATA[JSONSetElement ( $usluga ; "[" & $uIdx & "]" ; $item ; JSONObject )]]></Calculation></Value>
			</Step>
			<Step enable="True" id="141" name="Set Variable">
				<Name>$uIdx</Name>
				<Value><Calculation><![CDATA[$uIdx + 1]]></Calculation></Value>
			</Step>
		<Step enable="True" id="70" name="End If"/>

		<Step enable="True" id="141" name="Set Variable">
			<Name>$i</Name>
			<Value><Calculation><![CDATA[$i + 1]]></Calculation></Value>
		</Step>
	<Step enable="True" id="73" name="End Loop"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "sol" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Assemble the envelope ─────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$json</Name>
		<Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "klijent"         ; $klijent                                                   ; JSONObject ] ;
	[ "vozilo"          ; $vozilo                                                    ; JSONObject ] ;
	[ "opisProblema"    ; ServiceOrders::Description                                 ; JSONString ] ;
	[ "serviser"        ; ServiceOrders::TechnicianName_Calculation                  ; JSONString ] ;
	[ "pocetakRadova"   ; Trim ( GetAsText ( ServiceOrders::JobDate )    & " " & GetAsText ( ServiceOrders::JobTime ) )    ; JSONString ] ;
	[ "zavrsetakRadova" ; Trim ( GetAsText ( ServiceOrders::JobDateEnd ) & " " & GetAsText ( ServiceOrders::JobTimeEnd ) ) ; JSONString ] ;
	[ "napomene"        ; ServiceOrders::Remarks                                     ; JSONString ] ;
	[ "materijal"       ; $materijal                                                 ; JSONArray  ] ;
	[ "usluga"          ; $usluga                                                    ; JSONArray  ] ;
	[ "trosak"          ; $trosak                                                    ; JSONArray  ]
)]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── POST to the print server ──────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$curl</Name>
		<Value><Calculation><![CDATA["-X POST" &
" --max-time 15" &
" -H " & Quote ( "Content-Type: application/json; charset=utf-8" ) &
" --data-binary @$json"]]></Calculation></Value>
	</Step>

	<Step enable="True" id="160" name="Insert from URL">
		<NoInteract state="True"/>
		<DontEncodeURL state="False"/>
		<SelectAll state="True"/>
		<VerifySSLCertificates state="False"/>
		<CURLOptions>
			<Calculation><![CDATA[$curl]]></Calculation>
		</CURLOptions>
		<Calculation><![CDATA[$url]]></Calculation>
		<Text/>
		<Field>$response</Field>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$err</Name>
		<Value><Calculation><![CDATA[Get ( LastError )]]></Calculation>
		</Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$err ≠ 0]]></Calculation>
	</Step>
		<Step enable="True" id="87" name="Show Custom Dialog">
			<Title><Calculation><![CDATA["Štampa nije uspjela"]]></Calculation></Title>
			<Message><Calculation><![CDATA["Server za štampu nije dostupan (greška " & $err & ")." & ¶ & ¶ & $response]]></Calculation></Message>
			<Buttons>
				<Button CommitState="True"><Calculation><![CDATA["OK"]]></Calculation></Button>
			</Buttons>
		</Step>
	<Step enable="True" id="69" name="Else"/>
		<Step enable="True" id="87" name="Show Custom Dialog">
			<Title><Calculation><![CDATA["Štampa"]]></Calculation></Title>
			<Message><Calculation><![CDATA["Radni nalog je poslan na štampu."]]></Calculation></Message>
			<Buttons>
				<Button CommitState="True"><Calculation><![CDATA["OK"]]></Calculation></Button>
			</Buttons>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[$response]]></Calculation>
	</Step>

</fmxmlsnippet>
