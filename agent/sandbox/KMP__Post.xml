<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Validate and post a KalkulacijaMP — compute total, stamp DatumKnjizenja, set Status to Knjižena.</Text>
	</Step>

	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS: kalkulacijaID (text, required)
RETURNS: data.kalkulacijaID (text) | data.ukupnoMP_Roba (number)</Text>
		<Field table="" id="0" name="$README"/>
	</Step>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>

	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "kalkulacijaID" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "KMP_POST_START" ; "Posting kalkulacija " & $kalkulacijaID ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Validate ──────────────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $kalkulacijaID )]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "kalkulacijaID is required" ; "kalkulacijaID" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Load KalkulacijaMP ────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="6" name="Go to Layout">
		<LayoutDestination value="SelectedLayout"/>
		<Layout id="241" name="KMP__KalkulacijaMP"/>
		<Animation value="None"/>
	</Step>

	<Step enable="True" id="22" name="Enter Find Mode">
		<Pause state="False"/>
	</Step>

	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$kalkulacijaID]]></Calculation>
		<Field table="KMP__KalkulacijaMP" id="1" name="PrimaryKey"/>
	</Step>

	<Step enable="True" id="31" name="Perform Find">
		<Restore state="False"/>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( FoundCount ) = 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "NOT_FOUND" ; "KalkulacijaMP not found: " & $kalkulacijaID ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="6" name="Go to Layout">
			<LayoutDestination value="OriginalLayout"/>
			<Animation value="None"/>
		</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Guard: status and lines ───────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[KMP__KalkulacijaMP::Status ≠ "Otvorena"]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "INVALID_STATUS" ; "KalkulacijaMP is not Otvorena — current status: " & KMP__KalkulacijaMP::Status ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="6" name="Go to Layout">
			<LayoutDestination value="OriginalLayout"/>
			<Animation value="None"/>
		</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( KMP__Stavke::PrimaryKey )]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "NO_STAVKE" ; "KalkulacijaMP has no lines: " & $kalkulacijaID ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="6" name="Go to Layout">
			<LayoutDestination value="OriginalLayout"/>
			<Animation value="None"/>
		</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Validate lines — reject if any have missing Kolicina or ProdajnaCijena ──</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$invalidChk</Name>
		<Value><Calculation><![CDATA[epSQLExecute ( "SELECT COUNT(*) FROM KMP__Stavke s, KMP__SKMP_StavkePrimke sp WHERE s.PrimaryKey = sp.PrimaryKey AND s.ForeignKeyKalkulacijaID = ? AND (sp.Kolicina IS NULL OR sp.Kolicina <= 0 OR sp.ProdajnaCijena IS NULL OR sp.ProdajnaCijena <= 0)" ; "useSQLResult=invalidchk" ; $kalkulacijaID )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$invalidCount</Name>
		<Value><Calculation><![CDATA[If ( IsEmpty ( $invalidChk ) ; GetAsNumber ( epSQLResult ( 0 ; 0 ; "invalidchk" ) ) ; 0 )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "invalidchk" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$invalidCount > 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "INVALID_LINES" ; $invalidCount & " line(s) have missing or zero Kolicina / ProdajnaCijena" ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="6" name="Go to Layout">
			<LayoutDestination value="OriginalLayout"/>
			<Animation value="None"/>
		</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Validate lines — reject if RUCPostotak / RUCIznos / PDVPostotak / PDVIznos not computed ──</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$nRUCp</Name>
		<Value><Calculation><![CDATA[Let ( [
	chk = epSQLExecute ( "SELECT COUNT(*) FROM KMP__Stavke WHERE ForeignKeyKalkulacijaID = ? AND RUCPostotak IS NULL" ; "useSQLResult=uf1" ; $kalkulacijaID )
] ; If ( IsEmpty ( chk ) ; GetAsNumber ( epSQLResult ( 0 ; 0 ; "uf1" ) ) ; -1 ) )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "uf1" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$nRUCi</Name>
		<Value><Calculation><![CDATA[Let ( [
	chk = epSQLExecute ( "SELECT COUNT(*) FROM KMP__Stavke WHERE ForeignKeyKalkulacijaID = ? AND RUCIznos IS NULL" ; "useSQLResult=uf2" ; $kalkulacijaID )
] ; If ( IsEmpty ( chk ) ; GetAsNumber ( epSQLResult ( 0 ; 0 ; "uf2" ) ) ; -1 ) )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "uf2" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$nPDVp</Name>
		<Value><Calculation><![CDATA[Let ( [
	chk = epSQLExecute ( "SELECT COUNT(*) FROM KMP__Stavke WHERE ForeignKeyKalkulacijaID = ? AND PDVPostotak IS NULL" ; "useSQLResult=uf3" ; $kalkulacijaID )
] ; If ( IsEmpty ( chk ) ; GetAsNumber ( epSQLResult ( 0 ; 0 ; "uf3" ) ) ; -1 ) )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "uf3" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$nPDVi</Name>
		<Value><Calculation><![CDATA[Let ( [
	chk = epSQLExecute ( "SELECT COUNT(*) FROM KMP__Stavke WHERE ForeignKeyKalkulacijaID = ? AND PDVIznos IS NULL" ; "useSQLResult=uf4" ; $kalkulacijaID )
] ; If ( IsEmpty ( chk ) ; GetAsNumber ( epSQLResult ( 0 ; 0 ; "uf4" ) ) ; -1 ) )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "uf4" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$unfinishedCount</Name>
		<Value><Calculation><![CDATA[Max ( $nRUCp ; $nRUCi ; $nPDVp ; $nPDVi )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$unfinishedCount > 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "UNFINISHED_LINES" ;
	"Null field counts — RUCPostotak: " & $nRUCp & ", RUCIznos: " & $nRUCi & ", PDVPostotak: " & $nPDVp & ", PDVIznos: " & $nPDVi
; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="6" name="Go to Layout">
			<LayoutDestination value="OriginalLayout"/>
			<Animation value="None"/>
		</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Compute total ─────────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$totalChk</Name>
		<Value><Calculation><![CDATA[epSQLExecute ( "SELECT SUM(sp.Kolicina * sp.ProdajnaCijena) FROM KMP__Stavke s, KMP__SKMP_StavkePrimke sp WHERE s.PrimaryKey = sp.PrimaryKey AND s.ForeignKeyKalkulacijaID = ?" ; "useSQLResult=totalchk" ; $kalkulacijaID )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$ukupnoMP</Name>
		<Value><Calculation><![CDATA[If ( IsEmpty ( $totalChk ) ; GetAsNumber ( epSQLResult ( 0 ; 0 ; "totalchk" ) ) ; 0 )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "totalchk" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $totalChk ) or $ukupnoMP <= 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "INVALID_TOTAL" ; "Total MP is zero or could not be computed for kalkulacijaID: " & $kalkulacijaID ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="6" name="Go to Layout">
			<LayoutDestination value="OriginalLayout"/>
			<Animation value="None"/>
		</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Post ──────────────────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[GetAsNumber ( $ukupnoMP )]]></Calculation>
		<Field table="KMP__KalkulacijaMP" id="9" name="UkupnoMP_Roba"/>
	</Step>

	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[Get ( CurrentTimestamp )]]></Calculation>
		<Field table="KMP__KalkulacijaMP" id="11" name="DatumKnjizenja"/>
	</Step>

	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA["Knjižena"]]></Calculation>
		<Field table="KMP__KalkulacijaMP" id="10" name="Status"/>
	</Step>

	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoInteract state="True"/>
		<Option state="False"/>
		<ESSForceCommit state="False"/>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[Get ( LastError ) ≠ 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Response_AddError ( "COMMIT_FAILED" ; "Failed to post KalkulacijaMP (FM error " & Get ( LastError ) & ")" ; "" ; "{}" ; "" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[Log.add ( "error" ; "KMP_POST_COMMIT_FAILED" ; "Commit failed for kalkulacijaID " & $kalkulacijaID ; $params )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="68" name="If">
			<Calculation><![CDATA[$isRoot]]></Calculation>
		</Step>
			<Step enable="True" id="25" name="Perform Script">
				<Script id="780" name="UTIL__FlushLog"/>
				<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
			</Step>
		<Step enable="True" id="70" name="End If"/>
		<Step enable="True" id="6" name="Go to Layout">
			<LayoutDestination value="OriginalLayout"/>
			<Animation value="None"/>
		</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[Response_Finalize]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Success ───────────────────────────────────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ;
	[ "kalkulacijaID"  ; $kalkulacijaID            ; JSONString ] ;
	[ "ukupnoMP_Roba"  ; GetAsNumber ( $ukupnoMP ) ; JSONNumber ]
) )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[Log.add ( "info" ; "KMP_POST_DONE" ; "Posted kalkulacija " & $kalkulacijaID & " — ukupnoMP_Roba: " & $ukupnoMP ; $params )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$isRoot]]></Calculation>
	</Step>
		<Step enable="True" id="25" name="Perform Script">
			<Script id="780" name="UTIL__FlushLog"/>
			<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="6" name="Go to Layout">
		<LayoutDestination value="OriginalLayout"/>
		<Animation value="None"/>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[Response_Finalize]]></Calculation>
	</Step>

</fmxmlsnippet>
