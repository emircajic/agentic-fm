</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$setupErr</Name>
<Value><Calculation><![CDATA[epSQLExecute ( "INSERT INTO \"Dobavljaci\" (\"PrimaryKey\", \"NazivDobavljaca\") VALUES (?, ?)" ; "" ; $fxDob1 ; "Inter Cars TEST-" & $runTag )]]></Calculation></Value>
</Step>
