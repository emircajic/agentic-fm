</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$setupErr</Name>
<Value><Calculation><![CDATA[$setupErr & epSQLExecute ( "INSERT INTO \"Primke\" (\"PrimaryKey\", \"ForeignKeyDobavljacID\") VALUES (?, ?)" ; "" ; $fxPrimka2 ; $fxDob2 )]]></Calculation></Value>
</Step>
<Step enable="True" id="68" name="If">
<Calculation><![CDATA[not IsEmpty ( $setupErr )]]></Calculation>
</Step>
<Step enable="True" id="1" name="Perform Script">
<Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "label" ; "Test results: ORD workers — SETUP FAILED" ; JSONString ] ;
	[ "vars" ; JSONSetElement ( "{}" ; [ "setupErr" ; $setupErr ; JSONString ] ; [ "runTag" ; $runTag ; JSONString ] ) ; JSONRaw ]
)]]></Calculation>
<Script id="749" name="Agentic-fm Debug"/>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[epSQLExecute ( "DELETE FROM \"Primke\" WHERE \"PrimaryKey\" = ? OR \"PrimaryKey\" = ?" ; "" ; $fxPrimka1 ; $fxPrimka2 )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[epSQLExecute ( "DELETE FROM \"Dobavljaci\" WHERE \"PrimaryKey\" = ? OR \"PrimaryKey\" = ?" ; "" ; $fxDob1 ; $fxDob2 )]]></Calculation></Value>
</Step>
<Step enable="True" id="103" name="Exit Script">
<Calculation><![CDATA[JSONSetElement ( "{}" ; "setupFailed" ; True ; JSONBoolean )]]></Calculation>
</Step>
<Step enable="True" id="70" name="End If"/>
