<Name>$setupErr</Name>
<Value><Calculation><![CDATA[$setupErr & epSQLExecute ( "INSERT INTO \"Dobavljaci\" (\"PrimaryKey\", \"NazivDobavljaca\") VALUES (?, ?)" ; "" ; $fxDob2 ; "TEST-NoTemplate-" & $runTag )]]></Calculation></Value>
