<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Commit the picker selection onto the current ServiceOrders record (client and/or vehicle) and close the picker card window.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMETER (JSON): clientId (optional), vehicleId (optional), cancel (optional boolean)&#xD;CONTEXT: runs on the SO__ClientVehiclePicker card window (base TO ServiceOrders). Only non-empty values are written.</Text>
		<Field>$README</Field>
	</Step>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$json</Name>
		<Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$cancel</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "cancel" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$clientId</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "clientId" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$vehicleId</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "vehicleId" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[$cancel = True or $cancel = "true"]]></Calculation>
	</Step>
	<Step enable="True" id="121" name="Close Window">
		<LimitToWindowsOfCurrentFile state="True"/>
		<Window value="Current"/>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "status" ; "cancelled" ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Write selected client / vehicle onto the ServiceOrder</Text>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $clientId )]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$clientId]]></Calculation>
		<Field table="ServiceOrders" id="28" name="ForeignKeyClient"/>
	</Step>
	<Step enable="True" id="70" name="End If"/>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $vehicleId )]]></Calculation>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$vehicleId]]></Calculation>
		<Field table="ServiceOrders" id="46" name="ForeignKeyVehicle"/>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoInteract state="True"/>
	</Step>
	<Step enable="True" id="121" name="Close Window">
		<LimitToWindowsOfCurrentFile state="True"/>
		<Window value="Current"/>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "status" ; "ok" ; JSONString )]]></Calculation>
	</Step>

</fmxmlsnippet>
