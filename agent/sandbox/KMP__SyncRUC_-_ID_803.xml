<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Sync RUCPostotak ↔ RUCIznos for a single KMP__Stavke row — no layout navigation.</Text>
  </Step>
  <Step enable="False" id="61" name="Insert Text">
    <SelectAll state="False"/>
    <Text>PARAMS: stavkaID (text, required) — PrimaryKey of the KMP__Stavke row
kalkulacijaID (text, required) — PrimaryKey of the parent KMP__KalkulacijaMP
mode (text, required) — "postotak" or "iznos"

RETURNS: data.stavkaID (text)

NOTE: RUC base = Kolicina * NabavnaCijenaStavke * (1 - RabatPostotak/100) + ZavisniTroskovi</Text>
    <Field table="" id="0" name=""/>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "stavkaID|kalkulacijaID|mode|nabavnaTotal|rucPostotak|rucIznos|skipRefresh|skipCommit" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Log.add ( "info" ; "KMP_SYNC_RUC_START" ; "mode=" & $mode & " stavkaID=" & $stavkaID ; $params )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>── Validate ──────────────────────────────────────────────────────────────</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $stavkaID ) or IsEmpty ( $kalkulacijaID )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "stavkaID and kalkulacijaID are required" ; "stavkaID" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$mode ≠ "postotak" and $mode ≠ "iznos"]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "INVALID_PARAM" ; "mode must be postotak or iznos, got: " & $mode ; "mode" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Writability guard (all-or-nothing): probe StavkePrimke, retry, else revert + warn</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$lockRetry</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$locked</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLExecute ( "UPDATE StavkePrimke SET ProdajnaCijena = ProdajnaCijena WHERE PrimaryKey = ?" ; "" ; $stavkaID )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$probe</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $probe )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[0]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$locked</Name>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$lockRetry ≥ 3]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$lockRetry + 1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$lockRetry</Name>
  </Step>
  <Step enable="True" id="62" name="Pause/Resume Script">
    <PauseTime value="ForDuration"/>
    <Calculation><![CDATA[1]]></Calculation>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$locked]]></Calculation>
  </Step>
  <Step enable="True" id="51" name="Revert Record/Request">
    <NoInteract state="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "RECORD_LOCKED" ; "StavkePrimke " & $stavkaID & " je zakljucan u drugom prozoru ili od strane drugog korisnika" ; "ProdajnaCijena" ; "{}" ; $probe )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["Zapis zakljucan"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Ova stavka se trenutno ureduje u drugom prozoru ili od strane drugog korisnika. Promjena nije sacuvana. Zatvorite drugi prozor i pokusajte ponovo."]]></Calculation>
    </Message>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>── Read base values (no layout navigation) ───────────────────────────────</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLExecute (
	"SELECT sp.Kolicina * sp.NabavnaCijenaStavke * (1 - s.RabatPostotak / 100) + s.ZavisniTroskovi,
	        s.RUCPostotak,
	        s.RUCIznos
	 FROM KMP__Stavke s
	 INNER JOIN KMP__SKMP_StavkePrimke sp ON sp.PrimaryKey = s.PrimaryKey
	 WHERE s.PrimaryKey = ?" ;
	"useSQLResult=Yes" ;
	$stavkaID
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$sel</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $sel )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "SQL_ERROR" ; "SELECT failed: " & $sel ; "" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsNumber ( epSQLResult ( 0 ; 0 ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$nabavnaTotal</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsNumber ( epSQLResult ( 0 ; 1 ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$rucPostotak</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsNumber ( epSQLResult ( 0 ; 2 ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$rucIznos</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>── Compute and update ────────────────────────────────────────────────────</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not $skipCommit]]></Calculation>
  </Step>
  <Step enable="True" id="75" name="Commit Records/Requests">
    <NoInteract state="True"/>
    <Option state="False"/>
    <ESSForceCommit state="False"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$mode = "postotak"]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLExecute (
	"UPDATE KMP__Stavke SET RUCIznos = ? WHERE PrimaryKey = ?" ;
	"" ;
	$nabavnaTotal * $rucPostotak / 100 ;
	$stavkaID
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$upd</Name>
  </Step>
  <Step enable="True" id="69" name="Else">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[epSQLExecute (
	"UPDATE KMP__Stavke SET RUCPostotak = ? WHERE PrimaryKey = ?" ;
	"" ;
	If ( $nabavnaTotal ≠ 0 ; $rucIznos / $nabavnaTotal * 100 ; 0 ) ;
	$stavkaID
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$upd</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $upd )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_AddError ( "SQL_ERROR" ; "UPDATE failed: " & $upd ; "" ; "{}" ; "" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>── Chain SyncPDV — recompute PDVIznos after RUC changed ──────────────────</Text>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "stavkaID"      ; $stavkaID      ; JSONString ] ;
	[ "kalkulacijaID" ; $kalkulacijaID ; JSONString ] ;
	[ "mode"          ; "postotak"     ; JSONString ] ;
	[ "skipRefresh"   ; 1              ; JSONNumber ]
)]]></Calculation>
    <Script id="804" name="KMP__SyncPDV"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>── Chain totals ──────────────────────────────────────────────────────────</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not $skipRefresh]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[$kalkulacijaID]]></Calculation>
    <Script id="696" name="KMP__RefreshTotals"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>── Success ───────────────────────────────────────────────────────────────</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ; "stavkaID" ; $stavkaID ; JSONString ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Log.add ( "info" ; "KMP_SYNC_RUC_DONE" ; "mode=" & $mode & " stavkaID=" & $stavkaID ; $params )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$void</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$isRoot]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
    <Script id="780" name="UTIL__FlushLog"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response_Finalize]]></Calculation>
  </Step>
</fmxmlsnippet>
