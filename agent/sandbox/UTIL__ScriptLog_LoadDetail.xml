<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Load the LogJSON for one ScriptLog record and inject it into the LogViewer web viewer via receiveDetail(). Called by FileMaker.PerformScript from the webviewer when a row is expanded.</Text>
	</Step>

	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMS: raw PrimaryKey (text, required) — passed directly as Get(ScriptParameter) from FileMaker.PerformScript
RETURNS: nothing — calls receiveDetail(pk, logArray) in the LogViewer web viewer</Text>
		<Field>$README</Field>
	</Step>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>

	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$pk</Name>
		<Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[IsEmpty ( $pk )]]></Calculation>
	</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[""]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Query the LogJSON for this specific record ────────────────────────────────</Text>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$qErr</Name>
		<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT LogJSON FROM ScriptLog WHERE PrimaryKey = ?" ;
	"useSQLResult=logdetail" ;
	$pk
)]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[not IsEmpty ( $qErr ) or epSQLResultRowCount ( "logdetail" ) = 0]]></Calculation>
	</Step>
		<Step enable="True" id="141" name="Set Variable">
			<Name>$void</Name>
			<Value><Calculation><![CDATA[epSQLResultDelete ( "logdetail" )]]></Calculation></Value>
		</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[""]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$log</Name>
		<Value><Calculation><![CDATA[epSQLResult ( 0 ; 0 ; "logdetail" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$void</Name>
		<Value><Calculation><![CDATA[epSQLResultDelete ( "logdetail" )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="89" name="# (comment)">
		<Text>── Inject log array into the webviewer via receiveDetail(pk, logArray) ──────</Text>
	</Step>

	<Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
		<ObjectName>
			<Calculation><![CDATA["LogViewer"]]></Calculation>
		</ObjectName>
		<FunctionName>
			<Calculation><![CDATA["receiveDetail"]]></Calculation>
		</FunctionName>
		<Parameters Count="2">
			<P>
				<Calculation><![CDATA[$pk]]></Calculation>
			</P>
			<P>
				<Calculation><![CDATA[If ( JSONIsValid ( $log ) and not IsEmpty ( $log ) ; $log ; "[]" )]]></Calculation>
			</P>
		</Parameters>
	</Step>

	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[""]]></Calculation>
	</Step>

</fmxmlsnippet>
