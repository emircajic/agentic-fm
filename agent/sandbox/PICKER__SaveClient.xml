<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>PURPOSE: Create a new client (Fizičko or Pravno lice) from the Client/Vehicle picker web viewer, then push the new record back to JS via receiveClientSaved.</Text>
	</Step>
	<Step enable="False" id="61" name="Insert Text">
		<SelectAll state="False"/>
		<Text>PARAMETER (JSON): type (Fizičko lice|Pravno lice), firstName, lastName, companyName, idBroj, pdvBroj, phone, email, street, city&#xD;RETURNS (to JS receiveClientSaved): { client: {...} } or { error: "..." }</Text>
		<Field>$README</Field>
	</Step>

	<Step enable="True" id="85" name="Allow User Abort">
		<Set state="False"/>
	</Step>
	<Step enable="True" id="86" name="Set Error Capture">
		<Set state="True"/>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Parse parameter</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$json</Name>
		<Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$type</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "type" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$firstName</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "firstName" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$lastName</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "lastName" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$companyName</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "companyName" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$idBroj</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "idBroj" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$pdvBroj</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "pdvBroj" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$phone</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "phone" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$email</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "email" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$street</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "street" )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$city</Name>
		<Value><Calculation><![CDATA[JSONGetElement ( $json ; "city" )]]></Calculation></Value>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Validate</Text>
	</Step>
	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[If ( $type = "Pravno lice" ; IsEmpty ( $companyName ) ; IsEmpty ( $firstName ) and IsEmpty ( $lastName ) )]]></Calculation>
	</Step>
	<Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
		<ObjectName><Calculation><![CDATA["clientvehiclepicker"]]></Calculation></ObjectName>
		<FunctionName><Calculation><![CDATA["receiveClientSaved"]]></Calculation></FunctionName>
		<Parameters Count="1">
			<P><Calculation><![CDATA[JSONSetElement ( "{}" ; "error" ; "Unesite ime klijenta." ; JSONString )]]></Calculation></P>
		</Parameters>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[JSONSetElement ( "{}" ; "error" ; "validation" ; JSONString )]]></Calculation>
	</Step>
	<Step enable="True" id="70" name="End If"/>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Create record</Text>
	</Step>
	<Step enable="True" id="6" name="Go to Layout">
		<LayoutDestination value="SelectedLayout"/>
		<Layout id="11" name="Dev Clients"/>
		<Animation value=""/>
	</Step>
	<Step enable="True" id="7" name="New Record/Request"/>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$type]]></Calculation>
		<Field table="Clients" id="34" name="Type"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$firstName]]></Calculation>
		<Field table="Clients" id="7" name="FirstName"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$lastName]]></Calculation>
		<Field table="Clients" id="8" name="LastName"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$companyName]]></Calculation>
		<Field table="Clients" id="6" name="CompanyName"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$idBroj]]></Calculation>
		<Field table="Clients" id="37" name="IDBroj"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$pdvBroj]]></Calculation>
		<Field table="Clients" id="38" name="PDVBroj"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$phone]]></Calculation>
		<Field table="Clients" id="9" name="Phone"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$email]]></Calculation>
		<Field table="Clients" id="10" name="Email"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$street]]></Calculation>
		<Field table="Clients" id="12" name="MainAddressStreet"/>
	</Step>
	<Step enable="True" id="76" name="Set Field">
		<Calculation><![CDATA[$city]]></Calculation>
		<Field table="Clients" id="14" name="MainAddressCity"/>
	</Step>
	<Step enable="True" id="75" name="Commit Records/Requests">
		<NoInteract state="True"/>
	</Step>

	<Step enable="False" id="89" name="# (comment)">
		<Text>MARK: Build response and return to picker</Text>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$client</Name>
		<Value><Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "PrimaryKey" ; Clients::PrimaryKey ; JSONString ] ;
	[ "Type" ; Clients::Type ; JSONString ] ;
	[ "FirstName" ; Clients::FirstName ; JSONString ] ;
	[ "LastName" ; Clients::LastName ; JSONString ] ;
	[ "CompanyName" ; Clients::CompanyName ; JSONString ] ;
	[ "Phone" ; Clients::Phone ; JSONString ] ;
	[ "Email" ; Clients::Email ; JSONString ] ;
	[ "DisplayName_Display" ; Clients::DisplayName_Display ; JSONString ] ;
	[ "VehicleCount_Calculation" ; 0 ; JSONNumber ]
)]]></Calculation></Value>
	</Step>
	<Step enable="True" id="141" name="Set Variable">
		<Name>$payload</Name>
		<Value><Calculation><![CDATA[JSONSetElement ( "{}" ; "client" ; $client ; JSONObject )]]></Calculation></Value>
	</Step>
	<Step enable="True" id="6" name="Go to Layout">
		<LayoutDestination value="SelectedLayout"/>
		<Layout id="270" name="SO__ClientVehiclePicker"/>
		<Animation value=""/>
	</Step>
	<Step enable="True" id="175" name="Perform JavaScript in Web Viewer">
		<ObjectName><Calculation><![CDATA["clientvehiclepicker"]]></Calculation></ObjectName>
		<FunctionName><Calculation><![CDATA["receiveClientSaved"]]></Calculation></FunctionName>
		<Parameters Count="1">
			<P><Calculation><![CDATA[$payload]]></Calculation></P>
		</Parameters>
	</Step>
	<Step enable="True" id="103" name="Exit Script">
		<Calculation><![CDATA[$payload]]></Calculation>
	</Step>

</fmxmlsnippet>
