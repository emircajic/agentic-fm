<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Line-path SO transfer — PREPARE only. Captures the clicked portal row into Globals::ServiceOrderSelector (the picker WV reads stavkaPK/qty/naziv/jm; SO__ClosePicker reads currentWindow), then opens the SO picker. The transfer itself runs in SO__TransferStavka, called directly from the picker WV.</Text>
  </Step>
  <Step enable="False" id="61" name="Insert Text">
    <SelectAll state="False"/>
    <Text>PARAMS: "prepare" — anything else just clears the shared picker state.&#xD;&#xD;CONTEXT: portal row on IncomingOrders (193) — reads go through ORD__OrderLines / ORD__OL_Stock (remapped 2026-07-20; the legacy StavkePrimke/Artikli octopus TOs have no graph path from ORD__ORDERS).&#xD;&#xD;STAGE-3 CHANGES: callbackScript self-registration removed (vestigial — the line path never dispatched it); selectedServiceOrder/Number and pickerMode keys dropped (only the retired header-path flow used them).</Text>
    <Field>$README</Field>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$action</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$action = "prepare"]]></Calculation>
  </Step>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Capture stavka context before any layout switch</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OrderLines::PrimaryKey]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$stavkaPK</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OrderLines::ForeignKeyPrimkaID]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$fakturaPK</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OrderLines::ForeignKeyArtikalID]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$artikalPK</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OL_Stock::NazivArtikla]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$nazivArtikla</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OrderLines::Kolicina]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$kolicina</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OrderLines::JM]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$jm</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OrderLines::NabavnaCijenaStavke]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$nabavnaCijena</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OrderLines::ProdajnaCijena]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$prodajnaCijena</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OrderLines::QtyAvailable_Calculation]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$qtyAvailable</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[ORD__OrderLines::TransferStatus_Display]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$transferStatus</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( LayoutName )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$currentLayout</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Get ( WindowName )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$currentWindow</Name>
  </Step>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Store full context in shared global state</Text>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[JSONSetElement ( "{}" ;
	["currentLayout"             ; $currentLayout   ; JSONString] ;
	["currentRecordID"           ; ORD__ORDERS::PrimaryKey ; JSONString] ;
	["currentWindow"             ; $currentWindow   ; JSONString] ;
	["stavkaPK"                  ; $stavkaPK        ; JSONString] ;
	["fakturaPK"                 ; $fakturaPK       ; JSONString] ;
	["artikalPK"                 ; $artikalPK       ; JSONString] ;
	["nazivArtikla"              ; $nazivArtikla    ; JSONString] ;
	["kolicina"                  ; $kolicina        ; JSONNumber] ;
	["nabavnaCijena"             ; $nabavnaCijena   ; JSONNumber] ;
	["prodajnaCijena"            ; $prodajnaCijena  ; JSONNumber] ;
	["qtyAvailable"              ; $qtyAvailable    ; JSONNumber] ;
	["transferStatus"            ; $transferStatus  ; JSONString] ;
	["transferredQuantity"       ; $qtyAvailable    ; JSONNumber] ;
	["jm"                        ; $jm              ; JSONString]
)]]></Calculation>
    <Field table="Globals" id="22" name="ServiceOrderSelector"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Validate stavka has required data</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $stavkaPK ) or IsEmpty ( $artikalPK )]]></Calculation>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["Greška"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Ova stavka nema potrebne podatke. Provjerite da li je artikal odabran."]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[""]]></Calculation>
    <Field table="Globals" id="22" name="ServiceOrderSelector"/>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA["Missing data"]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Validate available quantity</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[$qtyAvailable <= 0]]></Calculation>
  </Step>
  <Step enable="True" id="87" name="Show Custom Dialog">
    <Title>
      <Calculation><![CDATA["Nema dostupne količine"]]></Calculation>
    </Title>
    <Message>
      <Calculation><![CDATA["Ova stavka je već u potpunosti iskorištena ili vraćena.¶¶Status: " & $transferStatus & "¶Dostupna količina: " & $qtyAvailable]]></Calculation>
    </Message>
    <Buttons>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
      <Button CommitState="False"/>
    </Buttons>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[""]]></Calculation>
    <Field table="Globals" id="22" name="ServiceOrderSelector"/>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA["No quantity available"]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="False" id="89" name="# (comment)">
    <Text>MARK: Open SO picker — qty input is handled inline in the picker web viewer</Text>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Script id="815" name="SO__OpenSOPicker"/>
  </Step>
  <Step enable="True" id="69" name="Else">
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[""]]></Calculation>
    <Field table="Globals" id="22" name="ServiceOrderSelector"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
</fmxmlsnippet>
