<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
<Step enable="True" id="89" name="# (comment)">
<Text>PURPOSE: Create one empty StavkaPrimke line on a Primka. Pure SQL — no layout hops.</Text>
</Step>
<Step enable="False" id="61" name="Insert Text">
<SelectAll state="False"/>
<Text>PARAMS: primkaID (text, required)&#xD;&#xD;RETURNS: data.stavkaID (text — PK of the new line)&#xD;&#xD;REPLACES: ORD__NewItem_phone (645). The phone navigation (Go to Layout slide) stays dispatcher-side; this worker only creates the row.</Text>
<Field>$README</Field>
</Step>
<Step enable="False" id="141" name="Set Variable">
<Name>$example_call</Name>
<Value><Calculation><![CDATA[JSONSetElement ( "{}" ; [ "primkaID" ; Primke::PrimaryKey ; JSONString ] )]]></Calculation></Value>
</Step>
<Step enable="True" id="89" name="# (comment)"/>
<Step enable="True" id="85" name="Allow User Abort">
<Set state="False"/>
</Step>
<Step enable="True" id="86" name="Set Error Capture">
<Set state="True"/>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[Params.parse ( Get ( ScriptParameter ) ; "primkaID" )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[Response_Init ( "{}" )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[Log.add ( "info" ; "ORD_NEW_ITEM_START" ; "New line on primka " & $primkaID ; $params )]]></Calculation></Value>
</Step>
<Step enable="True" id="89" name="# (comment)"/>
<Step enable="False" id="89" name="# (comment)">
<Text>MARK: Validate</Text>
</Step>
<Step enable="True" id="68" name="If">
<Calculation><![CDATA[IsEmpty ( $primkaID )]]></Calculation>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[Response_AddError ( "MISSING_PARAM" ; "primkaID is required" ; "primkaID" ; "{}" ; "" )]]></Calculation></Value>
</Step>
<Step enable="True" id="69" name="Else"/>
<Step enable="True" id="141" name="Set Variable">
<Name>$selPr</Name>
<Value><Calculation><![CDATA[epSQLExecute (
	"SELECT \"PrimaryKey\" FROM \"Primke\" WHERE \"PrimaryKey\" = ?" ;
	"useSQLResult=prim" ;
	$primkaID
)]]></Calculation></Value>
</Step>
<Step enable="True" id="68" name="If">
<Calculation><![CDATA[not IsEmpty ( $selPr ) or epSQLResultRowCount ( "prim" ) = 0]]></Calculation>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[Response_AddError ( "NOT_FOUND_PRIMKA" ; "Primka not found: " & $primkaID ; "primkaID" ; $params ; "" )]]></Calculation></Value>
</Step>
<Step enable="True" id="70" name="End If"/>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[epSQLResultDelete ( "prim" )]]></Calculation></Value>
</Step>
<Step enable="True" id="70" name="End If"/>
<Step enable="True" id="68" name="If">
<Calculation><![CDATA[Response_HasErrors ( $response )]]></Calculation>
</Step>
<Step enable="True" id="68" name="If">
<Calculation><![CDATA[$isRoot]]></Calculation>
</Step>
<Step enable="True" id="1" name="Perform Script">
<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
<Script id="780" name="UTIL__FlushLog"/>
</Step>
<Step enable="True" id="70" name="End If"/>
<Step enable="True" id="103" name="Exit Script">
<Calculation><![CDATA[Response_Finalize]]></Calculation>
</Step>
<Step enable="True" id="70" name="End If"/>
<Step enable="True" id="89" name="# (comment)"/>
<Step enable="False" id="89" name="# (comment)">
<Text>MARK: Insert</Text>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$stavkaID</Name>
<Value><Calculation><![CDATA[UUIDv7]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$ins</Name>
<Value><Calculation><![CDATA[epSQLExecute (
	"INSERT INTO \"StavkePrimke\" (\"PrimaryKey\", \"ForeignKeyPrimkaID\") VALUES (?, ?)" ;
	"" ;
	$stavkaID ;
	$primkaID
)]]></Calculation></Value>
</Step>
<Step enable="True" id="68" name="If">
<Calculation><![CDATA[not IsEmpty ( $ins )]]></Calculation>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[Response_AddError ( "INSERT_FAILED" ; "Failed to create line on primka " & $primkaID & " (" & $ins & ")" ; "primkaID" ; $params ; "" )]]></Calculation></Value>
</Step>
<Step enable="True" id="69" name="Else"/>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[Response_SetData ( JSONSetElement ( "{}" ; "stavkaID" ; $stavkaID ; JSONString ) )]]></Calculation></Value>
</Step>
<Step enable="True" id="141" name="Set Variable">
<Name>$void</Name>
<Value><Calculation><![CDATA[Log.add ( "info" ; "ORD_NEW_ITEM_DONE" ; "Created line " & $stavkaID & " on primka " & $primkaID ; $params )]]></Calculation></Value>
</Step>
<Step enable="True" id="70" name="End If"/>
<Step enable="True" id="68" name="If">
<Calculation><![CDATA[$isRoot]]></Calculation>
</Step>
<Step enable="True" id="1" name="Perform Script">
<Calculation><![CDATA[JSONSetElement ( "{}" ; "traceID" ; $traceID ; JSONString )]]></Calculation>
<Script id="780" name="UTIL__FlushLog"/>
</Step>
<Step enable="True" id="70" name="End If"/>
<Step enable="True" id="103" name="Exit Script">
<Calculation><![CDATA[Response_Finalize]]></Calculation>
</Step>
</fmxmlsnippet>
