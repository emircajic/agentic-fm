<fmxmlsnippet type="FMObjectList">

	<Step enable="True" id="89" name="# (comment)">
		<Text>── 3b. NIVELACIJE. Its own leg rather than a branch inside zaduzenja, because the sign of UkupnoRazlika decides which column each document lands in. ──</Text>
	</Step>

	<Step enable="True" id="1" name="Perform Script">
		<Script id="0" name="TK__GetNivelacije"/>
		<Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "companyID" ; $companyID ; JSONString ] ;
	[ "datumOd" ; $datumOd ; JSONString ] ;
	[ "datumDo" ; $datumDo ; JSONString ]
)]]></Calculation>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$nivelacijeResult</Name>
		<Value><Calculation><![CDATA[Get ( ScriptResult )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="141" name="Set Variable">
		<Name>$errors</Name>
		<Value><Calculation><![CDATA[JSONMergeArrays ( $errors ; JSONGetElement ( $nivelacijeResult ; "errors" ) )]]></Calculation></Value>
	</Step>

	<Step enable="True" id="68" name="If">
		<Calculation><![CDATA[JSONGetElement ( $nivelacijeResult ; "status" ) ≠ "success"]]></Calculation>
	</Step>
		<Step enable="True" id="103" name="Exit Script">
			<Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "status" ; "fail" ; JSONString ] ;
	[ "rows" ; $rows ; JSONArray ] ;
	[ "errors" ; JSONGetElement ( $nivelacijeResult ; "errors" ) ; JSONArray ]
)]]></Calculation>
		</Step>
	<Step enable="True" id="70" name="End If"/>

</fmxmlsnippet>
